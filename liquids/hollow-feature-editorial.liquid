<style>
  @font-face {
    font-family: "hfe-graphik-xxcond";
    src:
      url("https://hollowsocks.com/cdn/shop/t/413/assets/GraphikXXCond-Bold.woff2?v=131287753912708631821782403668") format("woff2"),
      url("https://hollowsocks.com/cdn/shop/t/413/assets/GraphikXXCond-Bold.woff?v=43780200223286244731782403668") format("woff");
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  @font-face {
    font-family: "hfe-neue-haas";
    src:
      url("https://hollowsocks.com/cdn/shop/t/413/assets/HaasGrotText-55Roman.woff2?v=69352221081524630201782403669") format("woff2"),
      url("https://hollowsocks.com/cdn/shop/t/413/assets/HaasGrotText-55Roman.woff?v=171200495703106418331782403669") format("woff");
    font-style: normal;
    font-weight: 400;
    font-display: swap;
  }

  .hfe-feature-editorial,
  .hfe-feature-editorial *,
  .hfe-feature-editorial *::before,
  .hfe-feature-editorial *::after {
    box-sizing: border-box !important;
  }

  .hfe-feature-editorial {
    width: 100% !important;
    max-width: none !important;
    margin: 0 !important;
    padding: 0 !important;
    display: grid !important;
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    align-items: stretch !important;
    gap: 0 !important;
    overflow: visible !important;
    color: #18191b !important;
    background: #ffffff !important;
  }

  .hfe-feature-editorial__features {
    min-width: 0 !important;
    margin: 0 !important;
    padding: 88px 20px !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: center !important;
    background: #041e3a !important;
  }

  .hfe-feature-editorial__feature-inner {
    position: sticky !important;
    top: 90px !important;
    width: 100% !important;
    max-width: 490px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 32px !important;
  }

  .hfe-feature-editorial__heading {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    color: #ffffff !important;
    font-family: "hfe-graphik-xxcond", "Arial Narrow", sans-serif !important;
    font-size: 40px !important;
    font-style: normal !important;
    font-weight: 700 !important;
    line-height: 0.88 !important;
    letter-spacing: 0.02em !important;
    text-align: center !important;
    text-transform: uppercase !important;
  }

  .hfe-feature-editorial__feature {
    width: 100% !important;
    max-width: 490px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start !important;
    justify-content: center !important;
    gap: 12px !important;
  }

  .hfe-feature-editorial__icon {
    width: 48px !important;
    height: 48px !important;
    min-width: 48px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    object-fit: cover !important;
    background: transparent !important;
  }

  .hfe-feature-editorial__feature-copy {
    min-width: 0 !important;
    width: 100% !important;
    max-width: 430px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-start !important;
    justify-content: center !important;
    gap: 12px !important;
  }

  .hfe-feature-editorial__feature-title,
  .hfe-feature-editorial__story-title {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    font-family: "hfe-graphik-xxcond", "Arial Narrow", sans-serif !important;
    font-size: 28px !important;
    font-style: normal !important;
    font-weight: 700 !important;
    line-height: 0.88 !important;
    letter-spacing: 0.02em !important;
    text-transform: uppercase !important;
  }

  .hfe-feature-editorial__feature-title {
    color: #ffffff !important;
    text-align: left !important;
  }

  .hfe-feature-editorial__feature-text,
  .hfe-feature-editorial__story-text {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    font-family: "hfe-neue-haas", Arial, sans-serif !important;
    font-size: 16px !important;
    font-style: normal !important;
    font-weight: 400 !important;
    line-height: 1.4 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
