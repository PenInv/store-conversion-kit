  .hfe-feature-editorial__feature-text {
    color: #ffffff !important;
    text-align: left !important;
  }

  .hfe-feature-editorial__stories {
    min-width: 0 !important;
    margin: 0 !important;
    padding: 56px 20px !important;
    display: flex !important;
    align-items: flex-start !important;
    justify-content: center !important;
    background: #ffffff !important;
  }

  .hfe-feature-editorial__story-list {
    width: 100% !important;
    max-width: 432px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 40px !important;
  }

  .hfe-feature-editorial__story {
    width: 100% !important;
    max-width: 432px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 16px !important;
  }

  .hfe-feature-editorial__media {
    width: 100% !important;
    height: 325px !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    overflow: hidden !important;
    border-radius: 8px !important;
    background: transparent !important;
  }

  .hfe-feature-editorial__photo {
    width: 100% !important;
    height: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: block !important;
    object-fit: cover !important;
    object-position: center !important;
    border: 0 !important;
  }

  .hfe-feature-editorial__story-copy {
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
  }

  .hfe-feature-editorial__story-title {
    color: #18191b !important;
    text-align: left !important;
  }

  .hfe-feature-editorial__story-text {
    color: #18191b !important;
    text-align: left !important;
  }

  @media screen and (max-width: 640px) {
    .hfe-feature-editorial {
      display: flex !important;
      flex-direction: column !important;
    }

    .hfe-feature-editorial__features {
      width: 100% !important;
      padding: 40px !important;
    }

    .hfe-feature-editorial__feature-inner {
      position: relative !important;
      top: auto !important;
      width: 100% !important;
      max-width: 490px !important;
    }

    .hfe-feature-editorial__feature {
      flex-direction: column !important;
      align-items: center !important;
      gap: 12px !important;
    }

    .hfe-feature-editorial__icon {
      width: 40px !important;
      height: 40px !important;
      min-width: 40px !important;
    }

    .hfe-feature-editorial__feature:last-child .hfe-feature-editorial__icon {
      width: 48px !important;
      height: 48px !important;
      min-width: 48px !important;
    }

    .hfe-feature-editorial__feature-copy {
      width: 100% !important;
      max-width: none !important;
      align-items: center !important;
    }

    .hfe-feature-editorial__feature-title,
    .hfe-feature-editorial__feature-text {
      text-align: center !important;
    }

    .hfe-feature-editorial__stories {
      width: 100% !important;
      padding: 40px 10px !important;
    }

    .hfe-feature-editorial__story-list {
      max-width: 432px !important;
      gap: 48px !important;
    }

    .hfe-feature-editorial__story {
      max-width: none !important;
      flex-direction: column-reverse !important;
    }

    .hfe-feature-editorial__media {
      height: 300px !important;
    }

    .hfe-feature-editorial__story-title,
    .hfe-feature-editorial__story-text {
      text-align: center !important;
    }
  }
</style>

