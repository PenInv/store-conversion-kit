<style>
  .edps-tc-root { box-sizing: border-box !important; }
  .edps-tc-root *, .edps-tc-root *::before, .edps-tc-root *::after { box-sizing: border-box !important; }

  .edps-tc-root {
    width: 100vw !important;
    max-width: 100vw !important;
    margin-left: calc(50% - 50vw) !important;
    margin-right: calc(50% - 50vw) !important;
    background: #ffffff !important;
    font-family: Inter, sans-serif !important;
    padding: 0 !important;
  }

  .edps-tc-grid {
    display: grid !important;
    grid-template-columns: 1fr 1fr !important;
    gap: 20px !important;
    width: 100% !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .edps-tc-card {
    position: relative !important;
    overflow: hidden !important;
    display: block !important;
    text-decoration: none !important;
    color: #000000 !important;
  }

  .edps-tc-card::before {
    content: '' !important;
    display: block !important;
    width: 100% !important;
    padding-bottom: 41.68421052631579% !important;
  }

  .edps-tc-img {
    position: absolute !important;
    inset: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    display: block !important;
  }

  .edps-tc-content {
    position: absolute !important;
    inset: 0 !important;
    display: flex !important;
    align-items: center !important;
    padding: 0 100px !important;
    pointer-events: none !important;
  }
  .edps-tc-card--left .edps-tc-content { justify-content: flex-start !important; }
  .edps-tc-card--right .edps-tc-content { justify-content: flex-end !important; }

  .edps-tc-text {
    max-width: 55% !important;
    pointer-events: auto !important;
  }
  .edps-tc-title p { white-space: nowrap !important; }
  .edps-tc-card--left .edps-tc-text { text-align: left !important; }
  .edps-tc-card--right .edps-tc-text { text-align: right !important; }

  .edps-tc-title {
    font-family: Inter, sans-serif !important;
    font-weight: 800 !important;
    font-size: 34px !important;
    line-height: 1.15 !important;
    letter-spacing: -0.02em !important;
    color: #0a0a0a !important;
    margin: 0 0 24px 0 !important;
  }
  .edps-tc-title p { margin: 0 !important; padding: 0 !important; font: inherit !important; color: inherit !important; }

  .edps-tc-learn {
    display: inline-flex !important;
    align-items: center !important;
    gap: 6px !important;
    font-family: Inter, sans-serif !important;
    font-weight: 500 !important;
    font-size: 15px !important;
    line-height: 1 !important;
    color: #0a0a0a !important;
    text-decoration: none !important;
    letter-spacing: -0.01em !important;
  }
  .edps-tc-arrow {
    width: 6px !important;
    height: 10px !important;
    display: inline-block !important;
    flex-shrink: 0 !important;
  }

  @media screen and (min-width: 1025px) and (max-width: 1365px) {
    .edps-tc-content { padding: 0 80px !important; }
    .edps-tc-title { font-size: 30px !important; margin-bottom: 20px !important; }
  }

  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .edps-tc-card::before { padding-bottom: 59.43536404160475% !important; }
    .edps-tc-content { padding: 0 40px !important; }
    .edps-tc-title { font-size: 22px !important; margin-bottom: 14px !important; }
    .edps-tc-learn { font-size: 13px !important; }
    .edps-tc-arrow { width: 5px !important; height: 8px !important; }
    .edps-tc-card--right .edps-tc-content { justify-content: flex-start !important; }
    .edps-tc-card--right .edps-tc-text { text-align: left !important; max-width: 60% !important; }
    .edps-tc-text { max-width: 60% !important; }
  }

  @media screen and (max-width: 767px) {
    .edps-tc-root { padding-top: 8px !important; }
    .edps-tc-grid { grid-template-columns: 1fr 1fr !important; gap: 8px !important; }
    .edps-tc-card::before { padding-bottom: 152% !important; }
    .edps-tc-content { padding: 18px 16px !important; align-items: flex-start !important; justify-content: flex-start !important; }
    .edps-tc-card--right .edps-tc-content { justify-content: flex-start !important; }
    .edps-tc-card--right .edps-tc-text { text-align: left !important; }
    .edps-tc-text { max-width: 100% !important; }
    .edps-tc-title { font-size: 22px !important; line-height: 1.15 !important; margin-bottom: 12px !important; }
    .edps-tc-title p { white-space: normal !important; }
    .edps-tc-learn { font-size: 13px !important; }
    .edps-tc-arrow { width: 5px !important; height: 8px !important; }
  }
</style>

