<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">

{%- comment -%}
  ============================================================
  SELLOUT RISK — OFFER ENDS IN (Custom Liquid)
  Clone da seção de reviews + banner de contagem regressiva da
  página getwidestep.com (BareFlex Pro BOGO).

  COMO EDITAR:
  - srx_minutes = duração do timer em minutos (reinicia a cada visita).
  - O texto do banner (com <strong> nos destaques) fica no HTML.
  - Começa fechado; clique no toggle para abrir o dropdown.

  ISOLAMENTO: tudo prefixado com .srx- e resetado com :where()
  + variáveis no escopo raiz, para blindar contra o CSS do tema.
  ============================================================
{%- endcomment -%}

{%- assign srx_minutes = 60 -%}

<section class="srx-section">
  <div class="srx-wrap">

    {%- comment -%} ===== Banner de oferta com contagem regressiva ===== {%- endcomment -%}
    <div class="srx-sellout-wrapper" data-srx-sellout>
      <button type="button" class="srx-sellout-toggle" aria-expanded="false">
        <span class="srx-sellout__dot"><span></span></span>
        <span class="srx-sellout__content">
          <span class="srx-sellout__text">Offer ends in</span>
          <span class="srx-sellout__timer" data-srx-countdown data-minutes="{{ srx_minutes }}">01:00:00</span>
          <span class="srx-sellout__icon" aria-hidden="true">
            <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 5L5 1L9 5" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          </span>
        </span>
      </button>
      <div class="srx-sellout-dropdown">
        <div class="srx-sellout-dropdown__content">
          <p>Our <strong>BUY 1 GET 1 FREE</strong> launch deal is clearing inventory twice as fast. Once the timer hits zero, any new orders go on the <strong>waitlist</strong> and <strong>won't include the free pair</strong>. Grab yours now before it's gone!</p>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
  /* ===== RESET DE ISOLAMENTO (baixa especificidade) ===== */
  .srx-section :where(a, span, div, p, button, svg) {
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    box-sizing: border-box;
    text-decoration: none;
    font: inherit;
    color: inherit;
  }

  .srx-section {
    --srx-font: 'Poppins', system-ui, -apple-system, sans-serif;
    --srx-ink: #1a1a1a;
    --srx-toggle-bg: #f7ece2;
    --srx-drop-bg: #fbf4ee;
    --srx-green-text: #B26B36;
    --srx-green-deep: #7a4622;
    --srx-timer-bg: #B26B36;
    --srx-dot: #c98a56;
    display: block;
    width: 100%;
    font-family: var(--srx-font);
    color: var(--srx-ink);
  }

  .srx-wrap {
    width: 100%;
    max-width: 100%;
  }

  /* ===== Banner de oferta ===== */
  .srx-sellout-wrapper {
    display: flex;
    flex-direction: column;
    width: fit-content;
    max-width: 100%;
    margin: 0 0 10px;
  }

  .srx-sellout-toggle {
    display: inline-flex !important;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 7px 12px;
    background: var(--srx-toggle-bg) !important;
    border: 0;
    border-radius: 10px;
    cursor: pointer;
    width: fit-content;
    max-width: 100%;
    position: relative;
  }

  .srx-sellout__dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background: var(--srx-dot) !important;
    position: relative;
    flex-shrink: 0;
  }

  .srx-sellout__dot span {
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: var(--srx-dot) !important;
  }

  .srx-sellout__content {
    display: flex;
    align-items: center;
    gap: 8px;
    min-width: 0;
  }

  .srx-sellout__text {
    font-size: 12.5px;
    line-height: 1.4;
    font-weight: 600;
    color: var(--srx-green-text);
  }

  .srx-sellout__timer {
    background: var(--srx-timer-bg) !important;
    color: #fdfcf9;
    font-weight: 700;
    font-size: 11.5px;
    line-height: 1;
    padding: 4px 8px;
    border-radius: 6px;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.3px;
    flex: 0 0 auto;
  }

  .srx-sellout__icon {
    display: flex;
    align-items: center;
    transition: transform 0.3s ease;
    transform: rotate(180deg);
    flex: 0 0 auto;
  }

  .srx-sellout__icon svg path {
    stroke: var(--srx-green-text);
  }

  .srx-sellout-wrapper.active .srx-sellout__icon {
    transform: rotate(0deg);
  }

  .srx-sellout-dropdown {
    background: var(--srx-drop-bg) !important;
    border-radius: 10px;
    padding: 0 14px;
    overflow: hidden;
    max-height: 0;
    opacity: 0;
    max-width: 60ch;
    transition: max-height 0.35s ease, opacity 0.35s ease, padding 0.35s ease, margin-top 0.35s ease;
  }

  .srx-sellout-wrapper.active .srx-sellout-dropdown {
    max-height: 300px;
    opacity: 1;
    padding: 10px 14px;
    margin-top: 8px;
  }

  .srx-sellout-dropdown__content {
    color: var(--srx-green-deep);
    font-size: 12px;
    line-height: 1.55;
  }

  .srx-sellout-dropdown__content p {
    margin: 0;
  }

  .srx-sellout-dropdown__content strong {
    font-weight: 600;
  }
</style>

<script>
(function () {
  'use strict';

  function initSrx(root) {
    if (!root || root.dataset.srxReady === '1') return;
    root.dataset.srxReady = '1';

    var wrapper = root.querySelector('.srx-sellout-wrapper');
    var toggle = root.querySelector('.srx-sellout-toggle');
    var timerEl = root.querySelector('[data-srx-countdown]');

    // ---- Toggle abre/fecha ----
    if (toggle && wrapper) {
      toggle.addEventListener('click', function () {
        var open = wrapper.classList.toggle('active');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
    }

    // ---- Contagem regressiva ----
    if (timerEl) {
      var minutes = parseInt(timerEl.getAttribute('data-minutes'), 10) || 60;
      var end = Date.now() + minutes * 60 * 1000;

      function pad(n) { return n < 10 ? '0' + n : '' + n; }

      function tick() {
        var diff = Math.max(0, end - Date.now());
        var totalSec = Math.floor(diff / 1000);
        var h = Math.floor(totalSec / 3600);
        var m = Math.floor((totalSec % 3600) / 60);
        var s = totalSec % 60;
        timerEl.textContent = pad(h) + ':' + pad(m) + ':' + pad(s);
        if (diff <= 0) clearInterval(iv);
      }

      tick();
      var iv = setInterval(tick, 1000);
    }
  }

  function boot() {
    document.querySelectorAll('.srx-section').forEach(initSrx);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
})();
</script>
