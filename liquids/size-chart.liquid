  .sc-trigger:hover { color: #000; }

  @media (max-width: 540px) {
    .sc-drawer { max-width: 100%; }
    .sc-drawer__header { padding: 18px 20px; }
    .sc-panel__inner { padding: 20px 20px 28px; }
  }
</style>

