<script>
(function () {
  var trigger    = document.getElementById('sc-trigger-btn');
  var overlay    = document.getElementById('sc-overlay');
  var drawer     = document.getElementById('sc-drawer');
  var closeBtn   = document.getElementById('sc-close-btn');
  var track      = document.getElementById('sc-panels-track');
  var tabs       = drawer.querySelectorAll('.sc-drawer__tab');
  var moved      = false;

  function ensureMoved() {
    if (!moved) {
      document.body.appendChild(overlay);
      document.body.appendChild(drawer);
      moved = true;
    }
  }


  function openDrawer() {
    ensureMoved();
    drawer.classList.add('sc-open');
    overlay.classList.add('sc-open');
    document.body.style.overflow = 'hidden';
  }
  function closeDrawer() {
    drawer.classList.remove('sc-open');
    overlay.classList.remove('sc-open');
    document.body.style.overflow = '';
  }

  trigger.addEventListener('click', openDrawer);
  closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);
  document.addEventListener('keydown', function(e) { if (e.key === 'Escape') closeDrawer(); });


  function setTab(name) {
    tabs.forEach(function(t) { t.classList.toggle('sc-active', t.dataset.tab === name); });
    if (name === 'size') {
      track.classList.add('sc-show-size');
    } else {
      track.classList.remove('sc-show-size');
    }
  }

  tabs.forEach(function(tab) {
    tab.addEventListener('click', function() { setTab(tab.dataset.tab); });
    tab.addEventListener('keydown', function(e) { if (e.key === 'Enter' || e.key === ' ') setTab(tab.dataset.tab); });
  });


  var touchStartX = 0;
  var outer = drawer.querySelector('.sc-panels-outer');
  outer.addEventListener('touchstart', function(e) { touchStartX = e.touches[0].clientX; }, { passive: true });
  outer.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) < 40) return;
    var current = drawer.querySelector('.sc-drawer__tab.sc-active').dataset.tab;
    if (dx < 0 && current === 'fit') setTab('size');
    if (dx > 0 && current === 'size') setTab('fit');
  }, { passive: true });


  var pillToggle = document.getElementById('sc-pill-toggle');
  var pillBtns   = pillToggle ? pillToggle.querySelectorAll('.sc-unit-pill') : [];
  var tableIn    = document.getElementById('sc-table-in');
  var tableCm    = document.getElementById('sc-table-cm');

  pillBtns.forEach(function(btn) {
    btn.addEventListener('click', function() {
      var showIn = btn.dataset.unit === 'in';
      pillBtns.forEach(function(b) { b.classList.remove('sc-active'); });
      btn.classList.add('sc-active');
      if (tableIn) tableIn.style.display = showIn ? '' : 'none';
      if (tableCm) tableCm.style.display = showIn ? 'none' : '';
    });
  });
})();
</script>
