<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
  .sc-drawer *,
  .sc-drawer *::before,
  .sc-drawer *::after { box-sizing: border-box; }

  .sc-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    margin: 0;
    background: rgba(0,0,0,0.45);
    z-index: 2147483645;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
    transform: translateZ(0);
  }
  .sc-overlay.sc-open { opacity: 1; pointer-events: all; }

  .sc-drawer {
    position: fixed;
    top: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    left: auto !important;
    height: 100% !important;
    width: 100% !important;
    max-width: 620px;
    margin: 0 !important;
    background: #fff;
    z-index: 2147483646;
    transform: translateX(100%) translateZ(0);
    transform: translateX(100%);
    transition: transform 0.3s cubic-bezier(0.4,0,0.2,1);
    display: flex; flex-direction: column; overflow: hidden;
    font-family: 'Poppins', sans-serif; color: #000;
  }
  .sc-drawer.sc-open { transform: translateX(0); }


  .sc-drawer__header {
    display: flex; align-items: center; justify-content: space-between;
    padding: 22px 28px; border-bottom: 1.5px solid #000; flex-shrink: 0;
  }
  .sc-drawer__title {
    font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; color: #000; line-height: 1; margin: 0;
  }
  .sc-drawer__header-right { display: flex; align-items: center; gap: 12px; }

  .sc-close-btn {
    background: none; border: none; cursor: pointer; padding: 6px;
    color: #444; display: flex; align-items: center; justify-content: center;
    transition: color 0.15s, background 0.15s; border-radius: 2px; line-height: 1;
  }
  .sc-close-btn:hover { color: #000; background: #ebebeb; }


  .sc-drawer__tabs {
    display: flex; border-bottom: 1.5px solid #e0e0e0; flex-shrink: 0;
  }
  .sc-drawer__tab {
    flex: 1; padding: 14px 0; text-align: center; cursor: pointer;
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 600;
    letter-spacing: 0.1em; text-transform: uppercase; color: #999;
    border-bottom: 2.5px solid transparent; margin-bottom: -1.5px;
    transition: color 0.2s, border-color 0.2s; user-select: none;
  }
  .sc-drawer__tab.sc-active { color: #000; border-bottom-color: #000; }


  .sc-panels-outer { flex: 1; overflow: hidden; position: relative; }
  .sc-panels-track {
    display: flex; height: 100%; width: 200%;
    transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
  }
  .sc-panels-track.sc-show-size { transform: translateX(-50%); }
  .sc-panel { width: 50%; height: 100%; overflow-y: auto; }
  .sc-panel__inner { padding: 24px 28px 32px; }

  .sc-fit-img-row {
    display: flex; align-items: center; gap: 20px; margin-bottom: 28px;
    min-height: 160px;
  }
  .sc-fit-img {
    width: 48%; max-width: 200px; flex-shrink: 0;
    object-fit: contain; display: block; height: auto;
  }
  .sc-fit-legend {
    display: flex; flex-direction: column; justify-content: center;
    gap: 20px; flex: 1;
  }
  .sc-fit-legend-item {
    display: flex; align-items: center; gap: 12px;
  }
  .sc-fit-badge {
    flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
    background: #000; color: #fff;
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 700;
    display: flex; align-items: center; justify-content: center; line-height: 1;
  }
  .sc-fit-badge-label {
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 600;
    color: #000; letter-spacing: 0.01em;
  }


  .sc-fit-title {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.14em; text-transform: uppercase; color: #000;
    margin: 0 0 16px; padding: 0;
  }
  .sc-fit-illustration { display: block; margin: 0 auto 24px; max-width: 260px; width: 100%; }
  .sc-fit-steps { display: flex; flex-direction: column; gap: 20px; list-style: none; margin: 0; padding: 0; }
  .sc-fit-step { display: flex; gap: 14px; align-items: flex-start; }
  .sc-fit-step__num {
    flex-shrink: 0; width: 28px; height: 28px; border-radius: 50%;
    background: #000; color: #fff;
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700;
    display: flex; align-items: center; justify-content: center;
  }
  .sc-fit-step__title { font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin: 0 0 4px; color: #000; }
  .sc-fit-step__desc { font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 400; color: #333; line-height: 1.65; margin: 0; }


  .sc-find-title {
    font-family: 'Poppins', sans-serif; font-size: 17px; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.04em; text-align: center;
    margin: 0 0 18px; padding: 0; color: #000;
  }


  .sc-unit-toggle-pill {
    display: flex; align-items: center; justify-content: center;
    background: #e4e4e4; border-radius: 50px; padding: 4px; gap: 0;
    width: fit-content; margin: 0 auto 24px;
  }
  .sc-unit-pill {
    font-family: 'Poppins', sans-serif; font-size: 11px; font-weight: 700;
    letter-spacing: 0.08em; background: none; border: none; cursor: pointer;
    padding: 7px 24px; border-radius: 50px; color: #888;
    transition: background 0.2s, color 0.2s; line-height: 1;
  }
  .sc-unit-pill.sc-active { background: #111; color: #fff; }
  .sc-unit-pill:hover:not(.sc-active) { color: #333; }

  .sc-matrix-wrap { overflow-x: auto; -webkit-overflow-scrolling: touch; }

  .sc-matrix-layout { display: flex; align-items: stretch; gap: 0; }

  .sc-matrix-table { border-collapse: collapse; font-size: 13px; width: 100%; }

  .sc-matrix-table .sc-bust-group {
    font-family: 'Poppins', sans-serif !important; font-size: 13px !important; font-weight: 700 !important;
    letter-spacing: 0.16em !important; text-transform: uppercase !important; color: #000 !important;
    text-align: center !important; padding: 0 0 8px !important;
  }

  .sc-matrix-side-label {
    display: flex !important; align-items: center !important; justify-content: center !important;
    writing-mode: vertical-rl !important; transform: rotate(180deg) !important;
    font-family: 'Poppins', sans-serif !important; font-size: 13px !important; font-weight: 700 !important;
    letter-spacing: 0.18em !important; text-transform: uppercase !important; color: #000 !important;
    padding-right: 10px !important; flex-shrink: 0 !important; min-width: 28px !important;
  }

  .sc-matrix-table .sc-col-header {
    font-family: 'Poppins', sans-serif; font-size: 10px; font-weight: 700;
    letter-spacing: 0.06em; text-transform: uppercase; color: #000;
    text-align: center; padding: 8px 10px; border-bottom: 2px solid #000;
    white-space: nowrap; background: #fff;
  }
  .sc-matrix-table .sc-col-header:first-child { text-align: left; padding-left: 0; min-width: 58px; }

  .sc-matrix-table tbody tr { border-bottom: 1px solid #e4e4e4; }
  .sc-matrix-table tbody tr:last-child { border-bottom: none; }
  .sc-matrix-table tbody tr:nth-child(odd)  { background: #f7f7f7; }
  .sc-matrix-table tbody tr:nth-child(even) { background: #fff; }

  .sc-matrix-table .sc-row-label {
    font-family: 'Poppins', sans-serif; font-size: 12px; font-weight: 700;
    color: #000; padding: 13px 16px 13px 0; text-align: left; white-space: nowrap;
  }

  .sc-matrix-table .sc-cell {
    text-align: center; padding: 13px 10px;
    font-family: 'Poppins', sans-serif; font-size: 13px; font-weight: 600;
    color: #000; white-space: nowrap;
  }
  .sc-matrix-table .sc-cell.sc-empty { color: transparent; }

  .sc-hint {
    margin-top: 24px; padding: 14px 18px;
    background: #eaf6f0; border-left: 3px solid #3c9d6d;
    font-family: 'Poppins', sans-serif; font-size: 12px; color: #333; line-height: 1.7;
  }
  .sc-hint strong { color: #000; font-weight: 700; }


  .sc-trigger {
    display: inline-flex; align-items: center; gap: 8px;
    background: none; border: none; cursor: pointer; padding: 0;
    font-family: 'Poppins', sans-serif; font-size: 15px; font-weight: 500;
