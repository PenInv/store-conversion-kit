<style>
  .snvc-root *,
  .snvc-root *::before,
  .snvc-root *::after { box-sizing: border-box !important; }

  .snvc-root {
    --snvc-bg: #ffffff;
    --snvc-highlight: #ddeceb;
    --snvc-line: #d1d1d1;
    --snvc-text: #1a1a1a;
    background-color: var(--snvc-bg) !important;
    display: block !important;
    width: 100% !important;
    font-family: "Galano Grotesque", "Poppins", -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif !important;
    -webkit-font-smoothing: antialiased;
  }

  .snvc-root .snvc-inner {
    padding: 20px 0 !important;
    max-width: 1300px !important;
    margin: 0 auto !important;
  }

  .snvc-root .snvc-heading {
    text-align: center !important;
    margin: 0 0 30px !important;
    padding: 0 !important;
  }

  .snvc-root .snvc-title {
    font-family: inherit !important;
    font-size: 24px !important;
    font-weight: 400 !important;
    color: var(--snvc-text) !important;
    line-height: 1.3 !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    padding: 0 10px !important;
    margin: 0 !important;
  }

  .snvc-root .snvc-title strong {
    font-weight: 700 !important;
    color: var(--snvc-text) !important;
    font-family: inherit !important;
  }

  .snvc-root .snvc-title br { display: none !important; }

  .snvc-root .snvc-scroll {
    overflow-x: auto !important;
    -webkit-overflow-scrolling: touch !important;
  }

  .snvc-root .snvc-table {
    max-width: 1074px !important;
    width: 100% !important;
    margin: 0 auto !important;
    border-collapse: collapse !important;
    table-layout: fixed !important;
    background: var(--snvc-bg) !important;
    color: var(--snvc-text) !important;
  }

  .snvc-root .snvc-table th:first-child,
  .snvc-root .snvc-table td:first-child {
    width: 120px !important;
    min-width: 120px !important;
    max-width: 120px !important;
  }

  .snvc-root .snvc-table th:not(:first-child),
  .snvc-root .snvc-table td:not(:first-child) {
    width: 60px !important;
    min-width: 60px !important;
    max-width: 60px !important;
  }

  .snvc-root .snvc-table th,
  .snvc-root .snvc-table td {
    text-align: center !important;
    vertical-align: middle !important;
    border: 1px solid var(--snvc-line) !important;
    background-color: var(--snvc-bg);
    margin: 0 !important;
  }

  .snvc-root .snvc-table thead th {
    font-weight: 600 !important;
    color: #333 !important;
    border-top: none !important;
    border-left: none !important;
    border-right: none !important;
    vertical-align: bottom !important;
    padding: 4px 2px !important;
  }

  .snvc-root .snvc-table thead th:first-child {
    visibility: hidden !important;
    border: none !important;
  }

  .snvc-root .snvc-brand {
    display: block !important;
    font-size: 10px !important;
    font-weight: 600 !important;
    color: #333 !important;
    line-height: 1.25 !important;
    overflow-wrap: break-word !important;
    hyphens: none !important;
  }

  .snvc-root .snvc-table th.snvc-main {
    background: var(--snvc-highlight) !important;
    border: none !important;
    border-radius: 8px 8px 0 0 !important;
    padding: 8px 6px 20px !important;
    vertical-align: bottom !important;
  }

  .snvc-root .snvc-table td.snvc-main {
    background: var(--snvc-highlight) !important;
    font-weight: 600 !important;
    padding: 8px 6px !important;
    border-top: none !important;
    border-bottom: none !important;
    border-left: 1px solid var(--snvc-line) !important;
    border-right: 1px solid var(--snvc-line) !important;
  }

  .snvc-root .snvc-prod {
    display: flex !important;
    flex-direction: column !important;
    align-items: stretch !important;
    gap: 6px !important;
    padding: 6px 2px !important;
    width: 100% !important;
  }

  .snvc-root .snvc-logo {
    display: block !important;
    font-size: 11px !important;
    font-weight: 700 !important;
    color: #1a5f4a !important;
    line-height: 1.2 !important;
    letter-spacing: 0 !important;
    text-align: center !important;
    max-width: 100% !important;
  }

  .snvc-root .snvc-pack {
    width: 100% !important;
    max-width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    height: auto !important;
    object-fit: contain !important;
    display: block !important;
    background: transparent !important;
  }

  .snvc-root .snvc-table tbody td:first-child {
    text-align: left !important;
    font-weight: 400 !important;
    color: #333 !important;
    padding: 8px !important;
    font-size: 12px !important;
    line-height: 1.3 !important;
    vertical-align: middle !important;
    overflow-wrap: break-word !important;
  }

  .snvc-root .snvc-table tbody td:not(:first-child) {
    padding: 8px !important;
    height: 60px !important;
  }

  .snvc-root .snvc-icon {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;
    width: 16px !important;
    height: 16px !important;
    vertical-align: middle !important;
  }

  .snvc-root .snvc-icon svg {
    width: 100% !important;
    height: 100% !important;
    display: block !important;
  }

  .snvc-root .snvc-txt {
    font-size: 12px !important;
    font-weight: 500 !important;
    color: #333 !important;
    line-height: 1.2 !important;
    white-space: nowrap !important;
    display: inline-block !important;
  }

  .snvc-root .snvc-with-img {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 4px !important;
  }

  .snvc-root .snvc-thumb {
    width: 20px !important;
    height: auto !important;
    object-fit: contain !important;
    border-radius: 3px !important;
    display: block !important;
    flex: none !important;
  }

  .snvc-root .snvc-tail td {
    padding: 0 !important;
    border: none !important;
    height: 18px !important;
    background: var(--snvc-bg) !important;
  }

  .snvc-root .snvc-tail td.snvc-main {
    background: var(--snvc-highlight) !important;
    border-radius: 0 0 12px 12px !important;
  }

  @media (min-width: 1024px) {
    .snvc-root .snvc-inner { padding: 40px 20px !important; }
    .snvc-root .snvc-heading { margin-bottom: 40px !important; }
    .snvc-root .snvc-title { font-size: 32px !important; }
