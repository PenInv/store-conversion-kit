<style>
  /* ===== Tokens (resolvidos do tema WideStep) — escopados p/ raiz + overlays fixos ===== */
  .wsz-root,
  .wsz-fx {
    --ws-white:#FFFFFF; --ws-ink:#1A1A1A; --ws-navy:#B26B36; --ws-navy-deep:#96592C;
    --ws-muted:#5C5C5C; --ws-line:#C9C0B2; --ws-warm:#F7F6F2; --ws-sage:#B8C9B0;
    --ws-green-dark:#1F3326; --ws-gold:#C9A227; --ws-on-dark:#FFFFFF;
    --ws-r:12px; --ws-r-sm:8px; --ws-r-pill:9999px;
    --wsst-sheet-radius:22px; --wsst-modal-radius:18px;
    --ws-font-ui:inherit;
    --ws-font-display:inherit;
  }

  .wsz-root *, .wsz-root *::before, .wsz-root *::after,
  .wsz-fx *, .wsz-fx *::before, .wsz-fx *::after { box-sizing: border-box; }

  /* ===== Barra de botões (Find My Size / Size Chart) ===== */
  .wsz-root {
    display: block !important;
    width: 100% !important;
    max-width: 701px !important;
    margin: 16px auto !important;
    background: #ffffff !important;
    border: 1px solid var(--ws-line) !important;
    border-radius: 12px !important;
    font-family: inherit !important;
    -webkit-font-smoothing: antialiased;
  }

  .wsz-root .wsz-tabs {
    display: flex !important;
    flex-direction: row !important;
    width: 100% !important;
    background: #fcfcfb !important;
    border-radius: 10.5px !important;
    overflow: hidden !important;
  }

  .wsz-root .wsz-tab {
    flex: 1 1 50% !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 5px !important;
    padding: 6px 8px !important;
    min-height: 46px !important;
    margin: 0 !important;
    border: 0 !important;
    background: transparent !important;
    color: var(--ws-muted) !important;
    font-family: inherit !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    line-height: 14px !important;
    letter-spacing: normal !important;
    text-transform: none !important;
    cursor: pointer !important;
    -webkit-appearance: none !important;
    appearance: none !important;
  }

  .wsz-root .wsz-tab + .wsz-tab { border-left: 1px solid var(--ws-line) !important; }
  .wsz-root .wsz-tab:hover { background: rgba(0,0,0,0.02) !important; }

  .wsz-root .wsz-tab svg {
    width: 13px !important; height: 13px !important;
    flex: 0 0 auto !important; color: var(--ws-muted) !important; display: block !important;
  }

  /* ======================= FIND MY SIZE (quiz) ======================= */
  .wsz-fx.sf-overlay { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center; padding: 16px; overflow-y: auto; -webkit-overflow-scrolling: touch; font-family: var(--ws-font-ui); }
  .wsz-fx.sf-overlay[hidden] { display: none; }
  .wsz-fx .sf-scrim { display: block; position: absolute; inset: 0; background: rgba(26,26,26,.5); opacity: 0; transition: opacity .28s; }
  .wsz-fx.sf-overlay.is-open .sf-scrim { opacity: 1; }
  .wsz-fx .sf-sheet { position: relative; width: min(460px, 100% - 32px); margin: auto; max-height: 92vh; display: flex; flex-direction: column; background: var(--ws-white); border-radius: var(--wsst-sheet-radius); box-shadow: rgba(26,26,26,.32) 0 24px 64px; transform: translateY(18px) scale(.985); opacity: 0; transition: transform .3s cubic-bezier(.32,.72,0,1), opacity .26s; }
  .wsz-fx.sf-overlay.is-open .sf-sheet { transform: translateY(0) scale(1); opacity: 1; }
  .wsz-fx .sf-grab { display: block; width: 42px; height: 4px; margin: 10px auto 2px; border: 0; border-radius: var(--ws-r-pill); background: var(--ws-line); cursor: pointer; }
  .wsz-fx .sf-head { padding: 6px 20px 0; }
  .wsz-fx .sf-track { height: 4px; border-radius: var(--ws-r-pill); background: var(--ws-warm); overflow: hidden; }
  .wsz-fx .sf-track__bar { display: block; height: 100%; width: 33%; background: var(--ws-navy); border-radius: var(--ws-r-pill); transition: width .3s; }
  .wsz-fx .sf-head__row { display: flex; align-items: center; justify-content: space-between; margin-top: 9px; }
  .wsz-fx .sf-step-label { font-family: var(--ws-font-ui); font-size: 11.5px; font-weight: 700; letter-spacing: .7px; text-transform: uppercase; color: var(--ws-muted); }
  .wsz-fx .sf-x { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; border: 0; background: none; font-size: 26px; line-height: 1; color: var(--ws-muted); cursor: pointer; padding: 0; margin: -4px -8px -4px 0; }
  .wsz-fx .sf-body { padding: 12px 20px 22px; overflow-y: auto; }
  .wsz-fx .sf-q { margin: 6px 0 7px; font-family: var(--ws-font-display); font-size: 22px; font-weight: 700; line-height: 1.2; color: var(--ws-navy); }
  .wsz-fx .sf-help { margin: 0 0 16px; font-family: var(--ws-font-ui); font-size: 13.5px; line-height: 1.45; color: var(--ws-muted); }
  .wsz-fx .sf-list { display: flex; flex-direction: column; gap: 10px; }
  .wsz-fx .sf-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .wsz-fx .sf-opt { display: flex; align-items: center; justify-content: space-between; gap: 8px; min-height: 54px; padding: 12px 16px; border: 1.5px solid var(--ws-line); border-radius: var(--ws-r); background: var(--ws-white); color: var(--ws-ink); font-family: var(--ws-font-ui); font-size: 15px; font-weight: 600; line-height: 1.25; text-align: left; cursor: pointer; transition: border-color .15s, background .15s, box-shadow .15s, transform .14s; }
  .wsz-fx .sf-opt:hover { border-color: var(--ws-navy); }
  .wsz-fx .sf-opt__sub { font-weight: 500; color: var(--ws-muted); font-size: 12.5px; }
  .wsz-fx .sf-opt__check { flex: 0 0 auto; width: 20px; height: 20px; border-radius: var(--ws-r-pill); border: 2px solid var(--ws-line); }
  .wsz-fx .sf-back { margin: 16px 0 0; border: 0; background: none; padding: 6px 2px; font-family: var(--ws-font-ui); font-size: 13px; font-weight: 600; color: var(--ws-muted); text-decoration: underline; cursor: pointer; }
  .wsz-fx .sf-cta { width: 100%; min-height: 54px; border: 0; border-radius: var(--ws-r); background: var(--ws-navy); color: var(--ws-on-dark); font-family: var(--ws-font-ui); font-size: 16px; font-weight: 800; text-transform: uppercase; letter-spacing: .3px; cursor: pointer; transition: background .15s; }
  .wsz-fx .sf-cta:hover { background: var(--ws-navy-deep); }
  .wsz-fx .sf-cta:focus-visible, .wsz-fx .sf-opt:focus-visible, .wsz-fx .sf-back:focus-visible,
  .wsz-fx .sf-x:focus-visible,
  .wsz-fx .sf-grab:focus-visible, .wsz-fx .sc-close:focus-visible { outline: 3px solid var(--ws-navy); outline-offset: 2px; }
  .wsz-fx .sf-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .wsz-fx .sf-opt--tile { justify-content: center; min-height: 52px; padding: 10px; font-size: 16px; font-weight: 700; }
  .wsz-fx .sf-opt--card { flex-direction: column; align-items: center; justify-content: center; gap: 9px; min-height: 110px; padding: 16px 10px; text-align: center; box-shadow: rgba(44,58,85,.06) 0 1px 3px; }
  .wsz-fx .sf-opt--card .sf-opt__label { font-size: 14px; }
  .wsz-fx .sf-opt__ic { display: inline-flex; align-items: center; justify-content: center; color: var(--ws-navy); }
  .wsz-fx .sf-opt--card .sf-opt__ic { width: 42px; height: 42px; }
  .wsz-fx .sf-opt--card .sf-opt__ic svg, .wsz-fx .sf-opt--card .sf-opt__ic img { width: 100%; height: 100%; object-fit: contain; }
  .wsz-fx .sf-opt--list .sf-opt__ic { width: 26px; height: 26px; flex: 0 0 auto; }
  .wsz-fx .sf-opt--list .sf-opt__ic svg, .wsz-fx .sf-opt--list .sf-opt__ic img { width: 100%; height: 100%; object-fit: contain; }
  .wsz-fx .sf-why { text-align: left; margin: 0 0 14px; padding: 14px 16px; background: var(--ws-white); border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
  .wsz-fx .sf-why__h { margin: 0 0 9px; font-family: var(--ws-font-display); font-size: 12.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase; color: var(--ws-navy); }
  .wsz-fx .sf-why__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
  .wsz-fx .sf-why__list li { display: flex; align-items: flex-start; gap: 9px; font-family: var(--ws-font-ui); font-size: 13px; line-height: 1.4; color: var(--ws-ink); }
  .wsz-fx .sf-why__c { flex: 0 0 auto; width: 18px; height: 18px; border-radius: var(--ws-r-pill); background: var(--ws-sage); color: var(--ws-green-dark); display: inline-flex; align-items: center; justify-content: center; margin-top: 1px; }
  .wsz-fx .sf-result { text-align: center; padding: 4px 0 2px; }
  .wsz-fx .sf-result__eyebrow { margin: 0 0 2px; font-family: var(--ws-font-ui); font-size: 13px; font-weight: 600; color: var(--ws-muted); }
  .wsz-fx .sf-result__expect { margin: 0 0 12px; font-family: var(--ws-font-ui); font-size: 12.5px; line-height: 1.5; color: var(--ws-muted); }
  .wsz-fx .sf-result__match { margin: 0 0 16px; font-family: var(--ws-font-ui); font-size: 14px; color: var(--ws-ink); }
  .wsz-fx .sf-result__match strong { color: var(--ws-green-dark); font-weight: 800; }
  .wsz-fx .sf-result__assure { display: flex; align-items: flex-start; gap: 8px; text-align: left; margin: 0 0 10px; padding: 11px 13px; background: var(--ws-warm); border-radius: var(--ws-r-sm); font-family: var(--ws-font-ui); font-size: 12.5px; line-height: 1.45; color: var(--ws-green-dark); }
  .wsz-fx .sf-result__assure-ic { flex: 0 0 auto; color: var(--ws-green-dark); margin-top: 1px; }
  .wsz-fx .sf-result__proof { margin: 0 0 16px; font-family: var(--ws-font-ui); font-size: 12px; line-height: 1.45; color: var(--ws-muted); }
  .wsz-fx .sf-body.sf-busy { pointer-events: none; }
  .wsz-fx .sf-opt.is-selected { border-color: var(--ws-green-dark); background: var(--ws-sage); color: var(--ws-green-dark); box-shadow: 0 0 0 2px var(--ws-green-dark), 0 6px 16px #1f33262e; }
  .wsz-fx .sf-opt.is-selected .sf-opt__ic { color: var(--ws-green-dark); }
  .wsz-fx .sf-opt--card.is-selected, .wsz-fx .sf-opt--tile.is-selected { transform: scale(1.03); }
  .wsz-fx .sf-opt--list.is-selected .sf-opt__check { border-color: var(--ws-green-dark); background: var(--ws-green-dark); }
  .wsz-fx .sf-intro { text-align: center; padding: 6px 4px 4px; }
  .wsz-fx .sf-intro__badge { width: 72px; height: 72px; margin: 8px auto 16px; border-radius: var(--ws-r-pill); background: var(--ws-sage); color: var(--ws-navy); display: flex; align-items: center; justify-content: center; box-shadow: rgba(44,58,85,.16) 0 10px 26px; }
  .wsz-fx .sf-intro__badge img { width: 58%; height: 58%; object-fit: contain; }
  .wsz-fx .sf-intro__h { margin: 0 0 10px; font-family: var(--ws-font-display); font-size: 25px; font-weight: 700; line-height: 1.15; color: var(--ws-navy); }
  .wsz-fx .sf-intro__p { margin: 0 auto 18px; max-width: 30em; font-family: var(--ws-font-ui); font-size: 14px; line-height: 1.55; color: var(--ws-muted); }
  .wsz-fx .sf-intro__trust { display: flex; flex-direction: column; gap: 9px; align-items: center; margin: 0 0 18px; padding: 14px; background: var(--ws-warm); border-radius: var(--ws-r); }
  .wsz-fx .sf-intro__stars, .wsz-fx .sf-intro__count { display: inline-flex; align-items: center; gap: 7px; font-family: var(--ws-font-ui); font-size: 13px; color: var(--ws-ink); }
  .wsz-fx .sf-intro__stars strong { font-weight: 700; }
  .wsz-fx .sf-stars { color: var(--ws-gold); letter-spacing: .5px; font-size: 14px; }
  .wsz-fx .sf-avs { display: inline-flex; }
  .wsz-fx .sf-avs i { width: 24px; height: 24px; border-radius: var(--ws-r-pill); background-size: cover; background-position: center; border: 2px solid var(--ws-warm); margin-left: -8px; }
  .wsz-fx .sf-avs i:first-child { margin-left: 0; }
  .wsz-fx .sf-intro__note { margin: 12px 0 2px; font-family: var(--ws-font-ui); font-size: 12px; color: var(--ws-muted); }
  .wsz-fx .sf-ring { position: relative; width: 132px; height: 132px; margin: 8px auto 12px; }
  .wsz-fx .sf-ring__svg { width: 100%; height: 100%; display: block; }
  .wsz-fx .sf-ring__bg { fill: none; stroke: var(--ws-warm); stroke-width: 9; }
  .wsz-fx .sf-ring__fg { fill: none; stroke: var(--ws-green-dark); stroke-width: 9; stroke-linecap: round; transform: rotate(-90deg); transform-origin: 64px 64px; transition: stroke-dashoffset 1.1s cubic-bezier(.32,.72,0,1); }
  .wsz-fx .sf-ring__c { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; }
  .wsz-fx .sf-ring__size { font-family: var(--ws-font-display); font-size: 35px; font-weight: 800; line-height: 1; color: var(--ws-navy); }
  .wsz-fx .sf-ring__sub { margin-top: 4px; font-family: var(--ws-font-ui); font-size: 11px; font-weight: 700; letter-spacing: .9px; text-transform: uppercase; color: var(--ws-muted); }
  @media (min-width: 480px) { .wsz-fx .sf-sheet { width: 460px; } }

  /* ======================= SIZE CHART ======================= */
  .wsz-fx.sc-overlay { position: fixed; inset: 0; z-index: 2147483000; display: flex; align-items: center; justify-content: center; padding: 20px; overflow-y: auto; -webkit-overflow-scrolling: touch; font-family: var(--ws-font-ui); }
  .wsz-fx.sc-overlay[hidden] { display: none; }
  .wsz-fx .sc-backdrop { display: block; position: absolute; inset: 0; background: rgba(26,26,26,.55); opacity: 0; transition: opacity .25s; }
  .wsz-fx.sc-overlay.is-open .sc-backdrop { opacity: 1; }
  .wsz-fx .sc-modal { position: relative; width: min(680px, 100%); margin: auto; max-height: none; background: var(--ws-white); border-radius: var(--wsst-modal-radius); padding: 30px clamp(20px, 4vw, 40px) 28px; box-shadow: rgba(26,26,26,.3) 0 30px 80px; transform: translateY(14px) scale(.98); opacity: 0; transition: transform .28s cubic-bezier(.4,0,.2,1), opacity .28s; }
  .wsz-fx.sc-overlay.is-open .sc-modal { transform: none; opacity: 1; }
  .wsz-fx .sc-close { position: absolute; top: 14px; right: 16px; width: 36px; height: 36px; border: 0; border-radius: var(--ws-r-pill); background: var(--ws-warm); color: var(--ws-ink); font-size: 24px; line-height: 1; cursor: pointer; }
  .wsz-fx .sc-close:hover { background: var(--ws-line); }
  .wsz-fx .sc-eyebrow { margin: 0 0 6px; font-family: var(--ws-font-display); font-size: 12px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--ws-navy); }
  .wsz-fx .sc-title { margin: 0 0 8px; font-family: var(--ws-font-display); font-size: 26px; font-weight: 700; color: var(--ws-navy); }
  .wsz-fx .sc-sub { margin: 0 0 22px; color: var(--ws-muted); font-family: var(--ws-font-ui); font-size: 15px; line-height: 1.5; }
  .wsz-fx .sc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: start; }
  .wsz-fx .sc-h3 { margin: 0 0 12px; font-family: var(--ws-font-ui); font-size: 15px; font-weight: 700; color: var(--ws-ink); }
  .wsz-fx .sc-steps { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 12px; }
  .wsz-fx .sc-steps li { display: flex; gap: 10px; font-family: var(--ws-font-ui); font-size: 14px; line-height: 1.45; color: var(--ws-ink); }
  .wsz-fx .sc-steps li span { flex: 0 0 auto; width: 22px; height: 22px; border-radius: var(--ws-r-pill); background: var(--ws-navy); color: var(--ws-white); font-size: 12px; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; }
  .wsz-fx .sc-tablewrap { overflow: hidden; border: 1px solid var(--ws-line); border-radius: 12px; }
  .wsz-fx .sc-table { width: 100%; border-collapse: collapse; font-family: var(--ws-font-ui); font-size: 14px; }
  .wsz-fx .sc-table th, .wsz-fx .sc-table td { padding: 10px 12px; text-align: center; }
  .wsz-fx .sc-table thead th { background: var(--ws-navy); color: var(--ws-white); font-weight: 700; font-size: 12.5px; letter-spacing: .3px; }
  .wsz-fx .sc-table tbody tr:nth-child(2n) { background: var(--ws-warm); }
  .wsz-fx .sc-table tbody td { border-top: 1px solid var(--ws-line); color: var(--ws-ink); }
  .wsz-fx .sc-note { margin: 20px 0 0; font-family: var(--ws-font-ui); font-size: 13px; color: var(--ws-muted); }
  @media (max-width: 640px) {
    .wsz-fx .sc-grid { grid-template-columns: 1fr; gap: 20px; }
    .wsz-fx .sc-title { font-size: 22px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .wsz-fx .sf-scrim, .wsz-fx .sf-sheet, .wsz-fx .sf-track__bar, .wsz-fx .sf-ring__fg { transition: none; }
  }
</style>

<div class="wsz-root">
  <div class="wsz-tabs">
    <button type="button" class="wsz-tab" id="sh-tab-find" data-sf-open aria-haspopup="dialog">
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="8" width="16" height="8" rx="2"></rect><path d="M8 8v3"></path><path d="M12 8v4"></path><path d="M16 8v3"></path></g></svg>Find My Size</button>
    <button type="button" class="wsz-tab" id="sh-tab-chart" aria-haspopup="dialog" aria-controls="sc-overlay">
