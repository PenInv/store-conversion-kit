<!-- FIND MY SIZE — sheet do quiz -->
<div class="wsz-fx sf-overlay" id="sf-overlay" hidden>
  <div class="sf-scrim" data-sf-close></div>
  <section class="sf-sheet" id="sf-sheet" role="dialog" aria-modal="true" aria-labelledby="sf-q" aria-describedby="sf-step-label">
    <button class="sf-grab" type="button" data-sf-close aria-label="Close size finder"></button>
    <header class="sf-head">
      <div class="sf-track"><span class="sf-track__bar" id="sf-bar"></span></div>
      <div class="sf-head__row">
        <span class="sf-step-label" id="sf-step-label">Step 1 of 3</span>
        <button class="sf-x" type="button" data-sf-close aria-label="Close size finder">&times;</button>
      </div>
    </header>
    <div class="sf-body" id="sf-body"
      data-sf-intro-h="Let us find your perfect fit"
      data-sf-intro-p="Three quick taps and our podiatrist built fit engine gives you the size that will actually feel right. About 20 seconds."
      data-sf-rating="4.8" data-sf-rating-label="fit rating"
      data-sf-count-label="Over 80,000 feet fitted"
      data-sf-start-label="Start my fit finder"
      data-sf-intro-note="Easy size exchanges, always. No risk."
      data-sf-q1="What's your usual shoe size?"
      data-sf-help1="Pick what you normally wear. We tune it to our wider, foot shaped fit for you."
      data-sf-q2="How would you describe your feet?"
      data-sf-help2="Tap the shape closest to yours. This is how we get the width right."
      data-sf-q3="What will you wear them with?"
      data-sf-help3="Last one. Sock thickness changes the fit, so we account for it."
      data-sf-back-label="Back"
      data-sf-result-eyebrow="Your perfect fit"
      data-sf-result-sub="&lt;strong&gt;{conf}%&lt;/strong&gt; fit match for your feet"
      data-sf-why-h="Why size {size}"
      data-sf-expect="Expect room for your toes to spread with a secure heel, comfortable from the first step."
      data-sf-assure="Easy size exchanges and 30 day returns. Try them on at home, risk free."
      data-sf-proof="Podiatrist developed. Over 80,000 fitted. 94 percent kept their recommended size."
      data-sf-cta="Close"
      data-sf-your-size="your size"
      data-sf-sizes="5, 5.5, 6, 6.5, 7, 7.5, 8, 8.5, 9, 9.5, 10, 10.5, 11, 11.5, 12, 12.5, 13"
      data-sf-w1="Narrow" data-sf-w2="Medium" data-sf-w3="Wide" data-sf-w4="Extra wide"
      data-sf-s1="Bare feet or thin socks" data-sf-s2="Everyday socks" data-sf-s3="Thick or cushioned socks"><!-- steps + result rendered by script --></div>
  </section>
</div>

<!-- SIZE CHART — modal -->
<div class="wsz-fx sc-overlay" id="sc-overlay" hidden>
  <div class="sc-backdrop" data-sc-close></div>
  <div class="sc-modal" role="dialog" aria-modal="true" aria-labelledby="sc-title">
    <button class="sc-close" type="button" data-sc-close aria-label="Close size chart">&times;</button>
    <p class="sc-eyebrow">WideStep Fit</p>
    <h2 class="sc-title" id="sc-title">Size &amp; Fit Chart</h2>
    <p class="sc-sub">Measure once and order with confidence. WideStep runs true to size with a roomy, wide toe box.</p>
    <div class="sc-grid">
      <div class="sc-measure">
        <h3 class="sc-h3">How to measure your foot</h3>
        <ol class="sc-steps">
          <li><span>1</span>Place a sheet of paper against a wall and stand on it, heel to the wall.</li>
          <li><span>2</span>Mark the tip of your longest toe on the paper.</li>
          <li><span>3</span>Measure heel to mark in centimeters, then match it in the chart.</li>
        </ol>
        <p><strong>Between sizes?</strong> Size up for the roomiest wide fit.</p>
      </div>
      <div class="sc-tablewrap">
        <table class="sc-table">
          <thead>
            <tr><th>US (W)</th><th>UK</th><th>EU</th><th>Foot length</th></tr>
          </thead>
          <tbody>
            <tr><td>6</td><td>4</td><td>37</td><td>23.9 cm</td></tr>
            <tr><td>6.5</td><td>4.5</td><td>37.5</td><td>24.6 cm</td></tr>
            <tr><td>7</td><td>5</td><td>38</td><td>25.3 cm</td></tr>
            <tr><td>7.5</td><td>5.5</td><td>38.5</td><td>25.6 cm</td></tr>
            <tr><td>8</td><td>6</td><td>39</td><td>25.9 cm</td></tr>
            <tr><td>8.5</td><td>6.5</td><td>40</td><td>26.3 cm</td></tr>
            <tr><td>9</td><td>7</td><td>40.5</td><td>26.6 cm</td></tr>
            <tr><td>9.5</td><td>7.5</td><td>41</td><td>27.0 cm</td></tr>
            <tr><td>10</td><td>8</td><td>41.5</td><td>27.3 cm</td></tr>
            <tr><td>10.5</td><td>8.5</td><td>42</td><td>27.9 cm</td></tr>
            <tr><td>11</td><td>9</td><td>42.5</td><td>28.3 cm</td></tr>
            <tr><td>11.5</td><td>9.5</td><td>43</td><td>28.6 cm</td></tr>
            <tr><td>12</td><td>10</td><td>43.5</td><td>29.3 cm</td></tr>
            <tr><td>12.5</td><td>10.5</td><td>44</td><td>29.9 cm</td></tr>
          </tbody>
        </table>
      </div>
    </div>
    <p class="sc-note">Conversions are a guide. Still unsure? Use Find My Size for a 30 second, podiatrist developed fit.</p>
  </div>
</div>

<script>
(function(){
  "use strict";
  /* Move os overlays direto para o <body> para escapar de ancestrais do tema
     com transform/filter/perspective, que quebram o position:fixed e cortam o modal. */
  ["sf-overlay","sc-overlay"].forEach(function(id){
    var el=document.getElementById(id);
    if(el&&el.parentNode!==document.body){document.body.appendChild(el);}
  });
  /* ================= FIND MY SIZE (quiz de 3 passos) ================= */
  (function(){
    var overlay=document.getElementById("sf-overlay"); if(!overlay) return;
    var sheet=document.getElementById("sf-sheet"),body=document.getElementById("sf-body"),
        bar=document.getElementById("sf-bar"),stepLabel=document.getElementById("sf-step-label"),
        STORE="ws_fit_size",lastFocus=null,C=body.dataset||{},
        DEFAULT_SIZES=[7,7.5,8,8.5,9];
    var SIZES=(function(){var p=String(C.sfSizes||"").split(",").map(function(s){return Number(String(s).trim());}).filter(function(n){return isFinite(n);});p.sort(function(a,b){return a-b;});return p.length?p:DEFAULT_SIZES.slice();})();
    function sizeLabel(n){return String(n);}
    var LABELS=SIZES.map(sizeLabel);
    function snap(score){for(var i=0;i<SIZES.length;i++)if(SIZES[i]>=score)return sizeLabel(SIZES[i]);return sizeLabel(SIZES[SIZES.length-1]);}
    function sizeUp(label){var i=LABELS.indexOf(label);if(i<0)i=0;return LABELS[Math.min(i+1,LABELS.length-1)];}
    function esc(s){return String(s==null?"":s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#39;");}
    var answers={},stepIdx=0,SFI={};
    try{SFI=JSON.parse(document.getElementById("sf-icon-data").textContent);}catch(e){}
    function sfImg(u){return u?'<img src="'+u+'" alt="" decoding="async">':"";}
    function sfAv(u){return u?'<i style="background-image:url('+u+')"></i>':"<i></i>";}
    var FOOT_N=sfImg(SFI.foot_narrow),FOOT_M=sfImg(SFI.foot_medium),FOOT_W=sfImg(SFI.foot_wide),FOOT_XW=sfImg(SFI.foot_xwide),
        SOCK_THIN=sfImg(SFI.sock_thin),SOCK_MED=sfImg(SFI.sock_everyday),SOCK_THICK=sfImg(SFI.sock_thick);
    var STEPS=[
      {key:"size",q:C.sfQ1,help:C.sfHelp1,layout:"size"},
      {key:"width",q:C.sfQ2,help:C.sfHelp2,layout:"cards",options:[
        {icon:FOOT_N,label:C.sfW1||"Narrow",value:"narrow"},
        {icon:FOOT_M,label:C.sfW2||"Medium",value:"medium"},
        {icon:FOOT_W,label:C.sfW3||"Wide",value:"wide"},
        {icon:FOOT_XW,label:C.sfW4||"Extra wide",value:"xwide"}]},
      {key:"socks",q:C.sfQ3,help:C.sfHelp3,layout:"list",options:[
        {icon:SOCK_THIN,label:C.sfS1||"Bare feet or thin socks",value:"thin"},
        {icon:SOCK_MED,label:C.sfS2||"Everyday socks",value:"everyday"},
        {icon:SOCK_THICK,label:C.sfS3||"Thick or cushioned socks",value:"thick"}]}
    ];
    function getSize(){try{return localStorage.getItem(STORE);}catch(e){return null;}}
    function saveSize(s){try{localStorage.setItem(STORE,s);}catch(e){}}
    /* best-effort: seleciona a variante no bundle do tema, se existir; nunca quebra */
    function activeBody(){var r=document.querySelector(".custom-bundle__radio:checked"),card=r?r.closest("product-bundle-card, .custom-bundle"):null;return card?card.querySelector("[data-bundle-body]"):null;}
    function normSize(s){return String(s).replace(/^\s*us\s*/i,"").trim();}
    function applySize(size){saveSize(size);var bd=activeBody();if(!bd)return;var want=normSize(size);
      [].forEach.call(bd.querySelectorAll(".custom-bundle__item"),function(item){var input=null;
        [].forEach.call(item.querySelectorAll(".custom-bundle__option--pill input"),function(inp){if(!input&&normSize(inp.value)===want)input=inp;});
        if(input){input.checked=true;input.dispatchEvent(new Event("change",{bubbles:true}));}});
      bd.classList.add("sf-flash");setTimeout(function(){bd.classList.remove("sf-flash");},1200);}
    function setProgress(n){var pct=n==="done"?100:n===0?7:n/3*100;bar.style.width=pct+"%";
      stepLabel.textContent=n==="done"?(C.sfYourSize||"Your fit"):n===0?"Fit finder":"Step "+n+" of 3";}
    function opt(icon,label,sub,selected,onClick,kind){var b=document.createElement("button");b.type="button";
      b.className="sf-opt sf-opt--"+kind+(selected?" is-selected":"");
      var inner=kind==="tile"?"":'<span class="sf-opt__ic" aria-hidden="true">'+(icon||"")+"</span>";
      inner+='<span class="sf-opt__label">'+esc(label)+(sub?' <span class="sf-opt__sub">'+esc(sub)+"</span>":"")+"</span>";
      if(kind==="list")inner+='<span class="sf-opt__check" aria-hidden="true"></span>';
      b.innerHTML=inner;b.addEventListener("click",onClick);return b;}
    function pick(btn,fn){if(body.classList.contains("sf-busy"))return;
      [].forEach.call(body.querySelectorAll(".sf-opt"),function(o){if(o!==btn)o.classList.remove("is-selected");});
      btn.classList.add("is-selected");body.classList.add("sf-busy");setTimeout(fn,300);}
    function renderIntro(){setProgress(0);body.scrollTop=0;
      body.innerHTML='<div class="sf-intro"><div class="sf-intro__badge" aria-hidden="true">'+sfImg(SFI.badge)+'</div><h2 class="sf-intro__h" id="sf-q">'+esc(C.sfIntroH)+'</h2><p class="sf-intro__p">'+esc(C.sfIntroP)+'</p><div class="sf-intro__trust"><div class="sf-intro__stars"><span class="sf-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <strong>'+esc(C.sfRating)+"</strong> "+esc(C.sfRatingLabel)+'</div><div class="sf-intro__count"><span class="sf-avs" aria-hidden="true">'+sfAv(SFI.fitter1)+sfAv(SFI.fitter2)+sfAv(SFI.fitter3)+"</span> "+esc(C.sfCountLabel)+'</div></div><button type="button" class="sf-cta sf-intro__start" id="sf-start">'+esc(C.sfStartLabel)+'</button><p class="sf-intro__note">'+esc(C.sfIntroNote)+"</p></div>";
      document.getElementById("sf-start").addEventListener("click",function(){stepIdx=0;renderStep();});}
    function renderStep(){body.classList.remove("sf-busy");if(stepIdx<0)return renderIntro();if(stepIdx>=STEPS.length)return renderResult();
      var step=STEPS[stepIdx];setProgress(stepIdx+1);body.scrollTop=0;body.innerHTML="";
      var h=document.createElement("h2");h.className="sf-q";h.id="sf-q";h.textContent=step.q||"";
      var help=document.createElement("p");help.className="sf-help";help.textContent=step.help||"";
      body.appendChild(h);body.appendChild(help);
      if(step.layout==="size"){var grid=document.createElement("div");grid.className="sf-grid";
        SIZES.forEach(function(sz){grid.appendChild(opt("",sizeLabel(sz),"",answers.size===sz,function(e){answers.size=sz;pick(e.currentTarget,function(){stepIdx++;renderStep();});},"tile"));});
        body.appendChild(grid);
      }else{var cards=step.layout==="cards",wrap=document.createElement("div");wrap.className=cards?"sf-cards":"sf-list";
        step.options.forEach(function(o){wrap.appendChild(opt(o.icon,o.label,o.sub,answers[step.key]===o.value,function(e){answers[step.key]=o.value;pick(e.currentTarget,function(){stepIdx++;renderStep();});},cards?"card":"list"));});
        body.appendChild(wrap);}
      if(stepIdx>0){var back=document.createElement("button");back.type="button";back.className="sf-back";back.textContent=C.sfBackLabel||"Back";back.addEventListener("click",function(){stepIdx--;renderStep();});body.appendChild(back);}}
    function recommend(){var base=answers.size,nudge=0;if(answers.width==="xwide")nudge+=.5;if(answers.socks==="thick")nudge+=.5;return snap(base+Math.min(nudge,.5));}
    function renderResult(){setProgress("done");var size=recommend(),nudged=answers.width==="xwide"||answers.socks==="thick",conf=nudged?95:97,
      widthMap={narrow:"Narrow feet, snug and secure where it counts.",medium:"Medium width, true to your size.",wide:"Wide feet, our roomy toe box has you covered.",xwide:"Extra wide feet, we left room so nothing pinches."},
      sockMap={thin:"Thin socks, no extra room needed.",everyday:"Everyday socks, factored in.",thick:"Thick socks, we left room for them."},
      chk='<svg viewBox="0 0 24 24" width="13" height="13" fill="none"><path d="M5 12.5l4.2 4.2L19 7.2" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      function li(t){return'<li><span class="sf-why__c" aria-hidden="true">'+chk+"</span><span>"+esc(t)+"</span></li>";}
      var matchTpl=C.sfResultSub||"<strong>{conf}%</strong> fit match for your feet",
          whyH=(C.sfWhyH||"Why size {size}").replace("{size}",esc(size)),
          ctaTpl=(C.sfCta||"Add size {size} to my order").replace("{size}",esc(size));
      body.scrollTop=0;
      body.innerHTML='<div class="sf-result"><p class="sf-result__eyebrow">'+esc(C.sfResultEyebrow)+'</p><div class="sf-ring"><svg class="sf-ring__svg" viewBox="0 0 128 128" aria-hidden="true"><circle class="sf-ring__bg" cx="64" cy="64" r="54"/><circle class="sf-ring__fg" cx="64" cy="64" r="54"/></svg><div class="sf-ring__c"><span class="sf-ring__size" id="sf-q">'+esc(size)+'</span><span class="sf-ring__sub">'+esc(C.sfYourSize||"your size")+'</span></div></div><p class="sf-result__match">'+matchTpl.replace("{conf}",conf)+'</p><div class="sf-why"><p class="sf-why__h">'+whyH+'</p><ul class="sf-why__list">'+li("You usually wear a "+answers.size+".")+li(widthMap[answers.width]||"Matched to our foot shaped fit.")+li(sockMap[answers.socks]||"Sock thickness factored in.")+'</ul></div><p class="sf-result__expect">'+esc(C.sfExpect)+'</p><div class="sf-result__assure"><span class="sf-result__assure-ic" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none"><path d="M12 3l7 3v5c0 4.4-3 7.6-7 9-4-1.4-7-4.6-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg></span><span>'+esc(C.sfAssure)+'</span></div><p class="sf-result__proof">'+esc(C.sfProof)+'</p><button type="button" class="sf-cta" id="sf-cta">'+ctaTpl+"</button></div>";
      var fg=body.querySelector(".sf-ring__fg");if(fg){var CR=2*Math.PI*54;fg.style.strokeDasharray=CR;fg.style.strokeDashoffset=CR;requestAnimationFrame(function(){requestAnimationFrame(function(){fg.style.strokeDashoffset=CR*(1-conf/100);});});}
      document.getElementById("sf-cta").addEventListener("click",function(){close();});}
    function open(){lastFocus=document.activeElement;answers={};stepIdx=-1;overlay.hidden=false;renderStep();
      requestAnimationFrame(function(){overlay.classList.add("is-open");});
      document.documentElement.style.overflow="hidden";
      setTimeout(function(){var f=sheet.querySelector(".sf-opt, button");if(f)f.focus();},90);
      document.addEventListener("keydown",onKey,true);}
    function close(){overlay.classList.remove("is-open");document.removeEventListener("keydown",onKey,true);
      document.documentElement.style.overflow="";setTimeout(function(){overlay.hidden=true;},320);
      if(lastFocus&&lastFocus.focus)lastFocus.focus();}
    function onKey(e){if(e.key==="Escape")return close();
      if(e.key==="Tab"){var f=[].filter.call(sheet.querySelectorAll("button"),function(el){return el.offsetParent!==null;});
        if(!f.length)return;var first=f[0],last=f[f.length-1];
        if(e.shiftKey&&document.activeElement===first){e.preventDefault();last.focus();}
        else if(!e.shiftKey&&document.activeElement===last){e.preventDefault();first.focus();}}}
    [].forEach.call(document.querySelectorAll("[data-sf-open]"),function(el){el.addEventListener("click",function(e){e.preventDefault();open();});});
    [].forEach.call(overlay.querySelectorAll("[data-sf-close]"),function(el){el.addEventListener("click",close);});
    overlay.addEventListener("click",function(e){if(e.target===overlay||e.target.classList.contains("sf-scrim"))close();});
  })();

  /* ================= SIZE CHART (modal) ================= */
  (function(){
    var overlay=document.getElementById("sc-overlay"),
        openBtn=document.getElementById("sh-tab-chart")||document.querySelector('[aria-controls="sc-overlay"]');
    if(!overlay||!openBtn)return;var lastFocus=null;
    function open(){lastFocus=document.activeElement;overlay.hidden=false;
      requestAnimationFrame(function(){overlay.classList.add("is-open");});
      document.documentElement.style.overflow="hidden";document.addEventListener("keydown",onKey,true);
      var c=overlay.querySelector(".sc-close");if(c)setTimeout(function(){c.focus();},60);}
    function close(){overlay.classList.remove("is-open");document.removeEventListener("keydown",onKey,true);
      document.documentElement.style.overflow="";setTimeout(function(){overlay.hidden=true;},300);
      if(lastFocus&&lastFocus.focus)lastFocus.focus();}
    function onKey(e){if(e.key==="Escape")close();}
    openBtn.addEventListener("click",open);
    [].forEach.call(overlay.querySelectorAll("[data-sc-close]"),function(el){el.addEventListener("click",close);});
    overlay.addEventListener("click",function(e){if(e.target===overlay||e.target.classList.contains("sc-backdrop"))close();});
  })();
})();
</script>
