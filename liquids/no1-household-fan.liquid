<style>
  .edps-rt-root { box-sizing: border-box !important; }
  .edps-rt-root *, .edps-rt-root *::before, .edps-rt-root *::after { box-sizing: border-box !important; }

  .edps-rt-root {
    width: 100% !important;
    padding: 60px 0 !important;
    background: #ffffff !important;
    font-family: Manrope, sans-serif !important;
    overflow: hidden !important;
  }

  .edps-rt-wrap {
    max-width: 1200px !important;
    margin: 0 auto !important;
    padding: 0 24px !important;
  }

  .edps-rt-logo {
    display: flex !important;
    justify-content: flex-start !important;
    margin-bottom: 60px !important;
  }
  .edps-rt-logo-desktop {
    display: block !important;
    width: 720px !important;
    max-width: 100% !important;
    height: auto !important;
  }
  .edps-rt-logo-mobile {
    display: none !important;
    width: 320px !important;
    max-width: 100% !important;
    height: auto !important;
  }

  @media screen and (min-width: 1200px) {
    .edps-rt-logo-desktop { width: 820px !important; }
  }

  .edps-rt-stats {
    display: flex !important;
    align-items: center !important;
    overflow: hidden !important;
    position: relative !important;
    width: 100% !important;
  }
  .edps-rt-track {
    display: flex !important;
    align-items: center !important;
    gap: 72px !important;
    will-change: transform !important;
    flex-wrap: nowrap !important;
    min-width: max-content !important;
  }
  .edps-rt-item {
    display: flex !important;
    flex-direction: column !important;
    gap: 4px !important;
    text-align: left !important;
    flex-shrink: 0 !important;
    min-width: max-content !important;
    white-space: nowrap !important;
  }
  .edps-rt-num {
    font-family: Manrope, sans-serif !important;
    font-weight: 700 !important;
    font-size: 52px !important;
    line-height: 1.2 !important;
    color: #000000 !important;
    margin: 0 !important;
    letter-spacing: 0 !important;
  }
  .edps-rt-text {
    font-family: Manrope, sans-serif !important;
    font-weight: 400 !important;
    font-size: 22px !important;
    line-height: 1.3 !important;
    color: rgba(0, 0, 0, 0.6) !important;
    margin: 0 !important;
    white-space: normal !important;
  }
  .edps-rt-divider {
    width: 1px !important;
    height: 68px !important;
    background-color: #D6D6D6 !important;
    flex-shrink: 0 !important;
    border-radius: 4px !important;
  }

  @media screen and (min-width: 750px) and (max-width: 1199px) {
    .edps-rt-root { padding: 80px 0 !important; }
    .edps-rt-logo { margin-bottom: 56px !important; }
    .edps-rt-track { gap: 56px !important; }
    .edps-rt-num { font-size: 40px !important; }
    .edps-rt-text { font-size: 18px !important; }
    .edps-rt-divider { height: 56px !important; }
  }

  @media screen and (min-width: 1200px) {
    .edps-rt-root { padding: 140px 0 !important; }
    .edps-rt-logo { margin-bottom: 72px !important; }
    .edps-rt-track { gap: 96px !important; }
    .edps-rt-num { font-size: 60px !important; }
    .edps-rt-text { font-size: 24px !important; }
    .edps-rt-divider { height: 76px !important; }
  }

  @media screen and (max-width: 749px) {
    .edps-rt-root { padding: 64px 0 !important; }
    .edps-rt-wrap { padding: 0 16px !important; }
    .edps-rt-logo { margin-bottom: 32px !important; }
    .edps-rt-logo-desktop { display: none !important; }
    .edps-rt-logo-mobile { display: block !important; }
    .edps-rt-track { gap: 24px !important; }
    .edps-rt-num { font-size: 18px !important; }
    .edps-rt-text { font-size: 12px !important; }
    .edps-rt-divider { height: 32px !important; }
  }
</style>

<section class="edps-rt-root" id="edps-rt-root">
  <div class="edps-rt-wrap">
    <div class="edps-rt-logo">
      <img
        src="https://www.dreo.com/cdn/shop/files/Household_fan_Heater_1.svg?v=1765421646&width=511"
        alt="No.1 Household Fan & Heater — Two Consecutive Years on Amazon U.S."
        class="edps-rt-logo-desktop"
        width="511"
        height="84"
        loading="lazy">
      <img
        src="https://www.dreo.com/cdn/shop/files/Household_fan_Heater_1.svg?v=1765421646&width=243"
        alt="No.1 Household Fan & Heater — Two Consecutive Years on Amazon U.S."
        class="edps-rt-logo-mobile"
        width="243"
        height="40"
        loading="lazy">
    </div>

    <div class="edps-rt-stats" data-edps-rt-carousel>
      <div class="edps-rt-track" data-edps-rt-track>
        <div class="edps-rt-item">
          <h3 class="edps-rt-num">300+</h3>
          <p class="edps-rt-text">Patented Innovation Technologies</p>
        </div>
        <div class="edps-rt-divider"></div>
        <div class="edps-rt-item">
          <h3 class="edps-rt-num">11,000+</h3>
          <p class="edps-rt-text">Available in 11,000+ Retail Stores Globally</p>
        </div>
        <div class="edps-rt-divider"></div>
        <div class="edps-rt-item">
          <h3 class="edps-rt-num">25 Million+</h3>
          <p class="edps-rt-text">Products Sold Worldwide</p>
        </div>
        <div class="edps-rt-divider"></div>
        <div class="edps-rt-item">
          <h3 class="edps-rt-num">500K+</h3>
          <p class="edps-rt-text">Happy Active Users on DREO App</p>
        </div>
        <div class="edps-rt-divider"></div>
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function initEdpsRt() {
      var carousel = document.querySelector('#edps-rt-root [data-edps-rt-carousel]');
      if (!carousel) return;
      var track = carousel.querySelector('[data-edps-rt-track]');
      if (!track || track.dataset.edpsRtInit === '1') return;

      var originalHTML = track.innerHTML;
      track.innerHTML = originalHTML + originalHTML;
      track.dataset.edpsRtInit = '1';

      var originalWidth = track.scrollWidth / 2;
      var currentTranslate = -originalWidth;
      var speed = 40;
      var lastTime = performance.now();
      var paused = false;

      carousel.addEventListener('mouseenter', function () { paused = true; });
      carousel.addEventListener('mouseleave', function () { paused = false; });

      function tick(now) {
        var dt = (now - lastTime) / 1000;
        lastTime = now;
        if (!paused) {
          currentTranslate += speed * dt;
          if (currentTranslate >= 0) {
            currentTranslate -= originalWidth;
          }
          track.style.transform = 'translateX(' + currentTranslate + 'px)';
        }
        requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initEdpsRt);
    } else {
      initEdpsRt();
    }
  })();
</script>
