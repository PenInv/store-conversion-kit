<script>
(function () {
  var root = document.currentScript.previousElementSibling;
  if (!root || !root.classList.contains('edps-vc-root')) return;

  var viewport = root.querySelector('.edps-vc-viewport');
  var track = root.querySelector('.edps-vc-track');
  var items = Array.prototype.slice.call(root.querySelectorAll('.edps-vc-item'));
  var prevBtn = root.querySelector('.edps-vc-nav--prev');
  var nextBtn = root.querySelector('.edps-vc-nav--next');
  if (!items.length) return;

  var current = Math.min(3, items.length - 1);

  function videoOf(i) { return items[i].querySelector('.edps-vc-video'); }
  function btnOf(i) { return items[i].querySelector('.edps-vc-playbtn'); }

  function play(i) {
    var v = videoOf(i), b = btnOf(i);
    if (!v || !b) return;
    v.muted = true;
    var p = v.play();
    if (p && p.catch) p.catch(function () {});
    b.classList.add('is-playing');
  }
  function pause(i) {
    var v = videoOf(i), b = btnOf(i);
    if (!v || !b) return;
    v.pause();
    b.classList.remove('is-playing');
  }

  // Centraliza o item ativo movendo o track. A largura do <li> não é animada
  // (só o conteúdo interno), então offsetLeft/offsetWidth já são os finais.
  function layout() {
    var item = items[current];
    var offset = item.offsetLeft + item.offsetWidth / 2 - viewport.clientWidth / 2;
    track.style.transform = 'translateX(' + (-offset) + 'px)';
  }

  function select(i, autoplay) {
    if (i < 0 || i >= items.length) return;
    items.forEach(function (el, idx) {
      el.classList.toggle('edps-vc-item--center', idx === i);
      if (idx !== i) pause(idx);
    });
    current = i;
    layout();
    if (autoplay) {
      var v = videoOf(i);
      if (!v) return;
      v.setAttribute('preload', 'auto');
      if (v.readyState >= 2) play(i);
      else v.addEventListener('loadeddata', function () { play(i); }, { once: true });
    }
  }

  items.forEach(function (item, i) {
    var btn = btnOf(i);
    var video = videoOf(i);
    if (btn) {
      btn.addEventListener('click', function (e) {
        e.stopPropagation();
        if (i !== current) { select(i, true); return; }
        if (video.paused) play(i); else pause(i);
      });
    }
    item.querySelector('.edps-vc-media').addEventListener('click', function () {
      if (i !== current) select(i, true);
    });
    if (video) {
      video.addEventListener('ended', function () {
        btn.classList.remove('is-playing');
      });
    }
  });

  if (prevBtn) prevBtn.addEventListener('click', function () { select(current - 1, true); });
  if (nextBtn) nextBtn.addEventListener('click', function () { select(current + 1, true); });

  window.addEventListener('resize', layout);
  select(current, true);
})();
</script>
