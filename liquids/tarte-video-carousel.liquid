<div class="edps-vc-root">
  <style>
    .edps-vc-root, .edps-vc-root * { box-sizing: border-box !important; }
    .edps-vc-root {
      max-width: 1560px !important;
      margin: 0 auto !important;
      padding: 16px 40px !important;
      font-family: Helvetica, Arial, sans-serif !important;
      position: relative !important;
    }
    .edps-vc-viewport {
      overflow: hidden !important;
      padding: 10px 0 !important;
    }
    .edps-vc-track {
      display: flex !important;
      align-items: center !important;
      gap: 20px !important;
      list-style: none !important;
      margin: 0 !important;
      padding: 0 !important;
      will-change: transform !important;
      transition: transform 0.5s ease !important;
    }

    /* A largura do item troca sem transição: o JS a usa para centralizar o
       slide ativo, e um valor interpolado daria uma posição errada. */
    .edps-vc-item {
      flex: 0 0 auto !important;
      width: 220px !important;
      display: flex !important;
      flex-direction: column !important;
      align-items: center !important;
      gap: 15px !important;
    }
    .edps-vc-item--center { width: 321px !important; }

    .edps-vc-media {
      position: relative !important;
      width: 100% !important;
      height: 293px !important;
      border-radius: 16px !important;
      overflow: hidden !important;
      background: #eee !important;
      cursor: pointer !important;
      transition: height 0.5s ease !important;
    }
    .edps-vc-item--center .edps-vc-media {
      height: 427px !important;
    }
    .edps-vc-media img,
    .edps-vc-media video {
      display: block !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      border-radius: 16px !important;
    }

    .edps-vc-playbtn {
      position: absolute !important;
      bottom: 12px !important;
      right: 12px !important;
      width: 48px !important;
      height: 48px !important;
      border-radius: 50% !important;
      background: rgba(0,0,0,0.3) !important;
      border: none !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      padding: 0 !important;
      cursor: pointer !important;
    }
    .edps-vc-playbtn svg { width: 20px !important; height: 20px !important; }
    .edps-vc-playbtn .edps-vc-icon-play { display: block !important; }
    .edps-vc-playbtn .edps-vc-icon-pause { display: none !important; }
    .edps-vc-playbtn.is-playing .edps-vc-icon-play { display: none !important; }
    .edps-vc-playbtn.is-playing .edps-vc-icon-pause { display: block !important; }

    .edps-vc-product {
      width: 100% !important;
      display: flex !important;
      align-items: center !important;
      gap: 10px !important;
      background: #fff !important;
      border: 1px solid rgb(216,216,216) !important;
      border-radius: 5px !important;
      padding: 12px !important;
      min-height: 110px !important;
    }

    .edps-vc-product img {
      width: 55px !important;
      height: 86px !important;
      object-fit: cover !important;
      flex: 0 0 auto !important;
    }
    .edps-vc-product-info {
      display: flex !important;
      flex-direction: column !important;
      gap: 4px !important;
      overflow: hidden !important;
    }
    .edps-vc-product-title {
      font-size: 16px !important;
      font-weight: 500 !important;
      line-height: 1.4 !important;
      color: rgb(74,68,78) !important;
      margin: 0 !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
    }
    .edps-vc-product-price {
      font-size: 14px !important;
      font-weight: 400 !important;
      color: rgb(74,68,78) !important;
      margin: 0 !important;
    }

    .edps-vc-nav {
      position: absolute !important;
      top: 50% !important;
      transform: translateY(-50%) !important;
      width: 36px !important;
      height: 36px !important;
      border-radius: 50% !important;
      background: #fff !important;
      border: 1px solid #ddd !important;
      display: flex !important;
      align-items: center !important;
      justify-content: center !important;
      cursor: pointer !important;
      z-index: 2 !important;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1) !important;
    }
    .edps-vc-nav--prev { left: 0px !important; }
    .edps-vc-nav--next { right: 0px !important; }
    .edps-vc-nav svg { width: 16px !important; height: 16px !important; }

    @media screen and (max-width: 749px) {
      .edps-vc-root { padding: 16px 0 !important; }
      .edps-vc-track { gap: 0 !important; }
      .edps-vc-item { gap: 12px !important; }

      /* Medidas do original (viewport 390px): lateral 210x280, centro 297x366. */
      .edps-vc-item { width: 53.85vw !important; }
      .edps-vc-item--center { width: 76.15vw !important; }
      .edps-vc-media { height: 71.8vw !important; }
      .edps-vc-item--center .edps-vc-media { height: 93.85vw !important; }

      /* No mobile o original só mostra o card de produto do slide central,
         e ele é mais estreito que o vídeo (279px contra 297px). */
      .edps-vc-product { display: none !important; }
      .edps-vc-item--center .edps-vc-product {
        display: flex !important;
        width: 93.94% !important;
