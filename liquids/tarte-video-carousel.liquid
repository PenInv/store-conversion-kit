      /* Os vídeos ficam centrados entre si, não o conjunto vídeo + card. */
      .edps-vc-track { align-items: flex-start !important; }
      .edps-vc-item { margin-top: 11.03vw !important; }
      .edps-vc-item--center { margin-top: 0 !important; }

      .edps-vc-nav--prev { left: 8px !important; }
      .edps-vc-nav--next { right: 8px !important; }
    }
