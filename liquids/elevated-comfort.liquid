<style>
  /* ===== ELEVATED COMFORT — bloco isolado (prefixo ecmf-) ===== */
  /* Conceito visual: sans grotesca bold, cinza-chumbo + destaque laranja */
  .ecmf-root,
  .ecmf-root *,
  .ecmf-root *::before,
  .ecmf-root *::after {
    box-sizing: border-box !important;
  }

  .ecmf-root {
    /* tokens do conceito */
    --ecmf-ink: #3d3d3d;        /* texto principal — cinza-chumbo */
    --ecmf-ink-soft: #5a5a5a;   /* texto de apoio */
    --ecmf-accent: #b26b36;     /* destaque — terracota/caramelo */
    --ecmf-bg: #ffffff;

    display: block !important;
    width: 100% !important;
    padding: 16px 0 !important;
    margin: 0 !important;
    background: var(--ecmf-bg) !important;
    font-family: Inter, "Helvetica Neue", Helvetica, Arial, sans-serif !important;
    color: var(--ecmf-ink) !important;
    letter-spacing: -0.4px !important;
    -webkit-font-smoothing: antialiased;
  }

  .ecmf-container {
    max-width: 1200px !important;
    width: 100% !important;
    margin: 0 auto !important;
    padding: 0 50px !important;
  }

  /* ---- Cabeçalho ---- */
  .ecmf-header {
    text-align: center !important;
    margin: 0 0 16px !important;
  }

  .ecmf-heading {
    margin: 0 !important;
    padding: 0 !important;
    font-family: inherit !important;
    font-size: 28px !important;
    font-weight: 800 !important;
    line-height: 1.25 !important;
    color: var(--ecmf-ink) !important;
    letter-spacing: -0.5px !important;
    text-transform: none !important;
    text-align: center !important;
  }

  /* trecho em destaque dentro de qualquer título/texto */
  .ecmf-accent {
    color: var(--ecmf-accent) !important;
    font-weight: inherit !important;
  }

  /* ---- Layout principal (3 colunas no desktop) ---- */
  .ecmf-main {
    display: flex !important;
    flex-direction: row !important;
    align-items: center !important;
    gap: 20px !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .ecmf-col-icons {
    flex: 1 1 0% !important;
    width: auto !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .ecmf-col-icons.ecmf-left  { order: 1 !important; }
  .ecmf-col-media            { order: 2 !important; flex: 0 0 40% !important; margin: 0 !important; padding: 0 !important; }
  .ecmf-col-icons.ecmf-right { order: 3 !important; }

  .ecmf-grid {
    display: grid !important;
    grid-template-columns: 1fr !important;
    gap: 32px !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
  }

  /* ---- Card de feature ---- */
  .ecmf-card {
    text-align: left !important;
    background: transparent !important;
    border: none !important;
    border-radius: 8px !important;
    padding: 0 !important;
    margin: 0 !important;
  }

  .ecmf-icon-wrap {
    display: flex !important;
    justify-content: flex-start !important;
    margin: 0 0 8px !important;
    padding: 0 !important;
  }

  .ecmf-icon {
    width: 60px !important;
    height: 60px !important;
    max-width: 100% !important;
    display: block !important;
    object-fit: contain !important;
    background: transparent !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
    border-radius: 0 !important;
  }

  .ecmf-card-title {
    margin: 0 0 12px !important;
    padding: 0 !important;
    font-family: inherit !important;
    font-size: 20px !important;
    font-weight: 800 !important;
    line-height: 1.3 !important;
    color: var(--ecmf-ink) !important;
    letter-spacing: -0.4px !important;
    text-align: left !important;
    text-transform: none !important;
  }

  .ecmf-card-text {
    margin: 0 !important;
    padding: 0 !important;
    font-family: inherit !important;
    font-size: 15px !important;
    font-weight: 400 !important;
    line-height: 1.6 !important;
    color: var(--ecmf-ink-soft) !important;
    letter-spacing: -0.2px !important;
    text-align: left !important;
    overflow-wrap: break-word !important;
  }

  /* trechos em negrito viram o laranja do conceito */
  .ecmf-card-text strong {
    font-weight: 800 !important;
    color: var(--ecmf-accent) !important;
  }

  /* ---- Mídia central (vídeo com fades laterais) ---- */
  .ecmf-media {
    position: relative !important;
    width: 100% !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* fade branco à esquerda e à direita, como no original */
  .ecmf-media::after,
  .ecmf-media::before {
    content: "" !important;
    position: absolute !important;
    top: 0 !important;
    bottom: 0 !important;
    width: 10% !important;
    pointer-events: none !important;
    z-index: 1 !important;
  }

  .ecmf-media::after {
    left: 0 !important;
    background: linear-gradient(to right, var(--ecmf-bg), transparent) !important;
  }

  .ecmf-media::before {
    right: 0 !important;
    background: linear-gradient(to left, var(--ecmf-bg), transparent) !important;
  }

  .ecmf-video-wrap {
    position: relative !important;
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    overflow: hidden !important;
    border: 0 !important;
    border-radius: 0 !important;
  }

  .ecmf-video {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    display: block !important;
    object-fit: cover !important;
    pointer-events: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border: none !important;
  }

  /* ---- Mobile (≤749px) ---- */
  @media only screen and (max-width: 749px) {
    .ecmf-container { padding: 0 15px !important; }

    .ecmf-heading { font-size: 24px !important; }

    .ecmf-main {
      flex-direction: column !important;
      gap: 0 !important;
    }

    /* vídeo primeiro, em full-bleed */
    .ecmf-col-media {
      order: 1 !important;
      flex: 1 1 0% !important;
      width: 100vw !important;
      max-width: 100vw !important;
      margin-left: calc(50% - 50vw) !important;
      margin-right: calc(50% - 50vw) !important;
    }

    .ecmf-media { margin-bottom: 24px !important; }

    /* fade de baixo no lugar dos laterais */
    .ecmf-media::before { display: none !important; }

    .ecmf-media::after {
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      width: auto !important;
      height: 10% !important;
      background: linear-gradient(transparent, var(--ecmf-bg)) !important;
    }

    .ecmf-col-icons.ecmf-left  { order: 2 !important; margin-bottom: 44px !important; }
    .ecmf-col-icons.ecmf-right { order: 3 !important; }

    .ecmf-col-icons {
      flex: 1 1 0% !important;
      width: 100% !important;
    }

    .ecmf-grid {
      grid-template-columns: repeat(2, 1fr) !important;
      gap: 44px 36px !important;
    }

    .ecmf-icon { width: 40px !important; height: 40px !important; }

    .ecmf-card-title { font-size: 16px !important; font-weight: 800 !important; margin-bottom: 10px !important; }
    .ecmf-card-text  { font-size: 14px !important; }
  }
</style>

