<script>
  /* Mede a largura real de um grupo e usa esse valor como deslocamento da
     animação. Sem isso, um translateX(-50%) erra a emenda sempre que a
     largura do track muda (fontes/ícones carregando depois, resize), e
     aparece um vão vazio no loop. Também mantém a velocidade constante
     (~66 px/s, a mesma do original) em qualquer largura de tela. */
  (function () {
    var strip = document.currentScript && document.currentScript.previousElementSibling;
    if (!strip || !strip.classList.contains('hbmq-strip')) {
      strip = document.querySelector('.hbmq-strip');
    }
    if (!strip) return;

    var track = strip.querySelector('.hbmq-track');
    var group = strip.querySelector('.hbmq-group');
    if (!track || !group) return;

    var SPEED = 66; /* px por segundo, medido no site original */

    function sync() {
      var w = group.getBoundingClientRect().width;
      if (!w) return;
      track.style.setProperty('--hbmq-shift', w + 'px');
      track.style.animationDuration = (w / SPEED).toFixed(2) + 's';
    }

    sync();

    /* Remede quando fontes e ícones terminam de carregar — é aí que a
       largura muda e a emenda sairia do lugar. */
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(sync);
    window.addEventListener('load', sync);

    var t;
    window.addEventListener('resize', function () {
      clearTimeout(t);
      t = setTimeout(sync, 150);
    });
  })();
</script>
