      padding: 0 16px !important;
    }

    .bsev-header {
      margin: 0 0 30px !important;
    }

    .bsev-heading {
      font-size: 24px !important;
      line-height: 34px !important;
    }

    .bsev-text p {
      font-size: 16px !important;
      line-height: 24px !important;
    }

    .bsev-controls {
      margin-top: 24px !important;
    }
  }
