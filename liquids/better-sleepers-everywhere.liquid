    margin: 0 0 10px !important;
    padding: 0 !important;
    text-transform: none !important;
  }

  .bsev-text {
    margin: 20px 0 20px !important;
  }

  .bsev-text p {
    font-family: 'Inter', sans-serif !important;
    font-size: 18px !important;
    font-weight: 500 !important;
    line-height: 28px !important;
    color: var(--bsev-green) !important;
    text-align: left !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* autor com selo de verificado */
  .bsev-author {
    display: flex !important;
    align-items: center !important;
  }

  .bsev-author svg {
    width: 24px !important;
    height: 24px !important;
    flex-shrink: 0 !important;
    display: block !important;
    margin-right: 4px !important;
    fill: var(--bsev-green) !important;
    color: var(--bsev-green) !important;
  }

  .bsev-author p {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    font-weight: 500 !important;
    line-height: 24px !important;
    color: var(--bsev-green) !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  /* ---------- CONTROLES ---------- */

  .bsev-controls {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 16px !important;
    margin-top: 32px !important;
  }

  .bsev-arrow {
    width: 44px !important;
    height: 44px !important;
    flex-shrink: 0 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    padding: 0 !important;
    border: 1px solid rgba(36, 66, 31, 0.35) !important;
    border-radius: 9999px !important;
    background: transparent !important;
    color: var(--bsev-green) !important;
    cursor: pointer !important;
    transition: border-color 0.18s, background 0.18s !important;
  }

  .bsev-arrow svg {
    width: 16px !important;
    height: 16px !important;
    display: block !important;
    fill: none !important;
    stroke: currentColor !important;
    stroke-width: 2 !important;
  }

  .bsev-arrow:hover {
    border-color: var(--bsev-green) !important;
    background: rgba(36, 66, 31, 0.06) !important;
  }

  .bsev-dots {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 8px !important;
  }

  .bsev-dot {
    width: 8px !important;
    height: 8px !important;
    padding: 0 !important;
    border: none !important;
    border-radius: 9999px !important;
    background: rgba(36, 66, 31, 0.25) !important;
    cursor: pointer !important;
    transition: background 0.18s, width 0.18s !important;
  }

  .bsev-dot.bsev-dot-active {
    width: 22px !important;
    background: var(--bsev-green) !important;
  }

  /* ---------- MOBILE ---------- */

  @media (max-width: 767px) {
    .bsev-root {
      /* mesma medida do original: card de 358px num viewport de 390px */
      --bsev-slide-w: calc(100vw - 32px);
