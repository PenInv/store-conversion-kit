<script>
  (function () {
    var root = document.querySelector('.bsev-root');
    if (!root || root.dataset.bsevInit) return;
    root.dataset.bsevInit = '1';

    var track = root.querySelector('#bsev-track');
    var slides = [].slice.call(root.querySelectorAll('.bsev-slide'));
    var dotsWrap = root.querySelector('#bsev-dots');
    var prevBtn = root.querySelector('#bsev-prev');
    var nextBtn = root.querySelector('#bsev-next');
    if (!track || !slides.length) return;

    var index = 0;

    // quantos slides cabem inteiros no viewport — define o nº de páginas
    function perView() {
      var vw = root.querySelector('.bsev-viewport').clientWidth;
      var step = slideStep();
      return Math.max(1, Math.min(slides.length, Math.round(vw / step)));
    }

    // largura de um slide + gap
    function slideStep() {
      var gap = parseFloat(getComputedStyle(track).gap) || 0;
      return slides[0].getBoundingClientRect().width + gap;
    }

    function maxIndex() {
      return Math.max(0, slides.length - perView());
    }

    function goTo(i, animate) {
      index = Math.max(0, Math.min(i, maxIndex()));
      if (animate === false) track.classList.add('bsev-dragging');
      track.style.transform = 'translate3d(' + (-index * slideStep()) + 'px,0,0)';
      if (animate === false) {
        void track.offsetWidth;
        track.classList.remove('bsev-dragging');
      }
      syncDots();
    }

    function buildDots() {
      dotsWrap.innerHTML = '';
      for (var i = 0; i <= maxIndex(); i++) {
        (function (i) {
          var d = document.createElement('button');
          d.type = 'button';
          d.className = 'bsev-dot';
          d.setAttribute('aria-label', 'Go to testimonial ' + (i + 1));
          d.addEventListener('click', function () { goTo(i); });
          dotsWrap.appendChild(d);
        })(i);
      }
      syncDots();
    }

    function syncDots() {
      [].forEach.call(dotsWrap.children, function (d, i) {
        d.classList.toggle('bsev-dot-active', i === index);
      });
    }

    prevBtn.addEventListener('click', function () { goTo(index - 1); });
    nextBtn.addEventListener('click', function () { goTo(index + 1); });

    // arrasto por ponteiro (mouse + touch), como no carrossel original
    var startX = 0, startTx = 0, dragging = false, moved = 0;

    track.addEventListener('pointerdown', function (e) {
      dragging = true;
      moved = 0;
      startX = e.clientX;
      startTx = -index * slideStep();
      track.classList.add('bsev-dragging');
      track.setPointerCapture(e.pointerId);
    });

    track.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      moved = e.clientX - startX;
      track.style.transform = 'translate3d(' + (startTx + moved) + 'px,0,0)';
    });

    function endDrag() {
      if (!dragging) return;
      dragging = false;
      track.classList.remove('bsev-dragging');
      // troca de slide quando o arrasto passa de 1/5 da largura do card
      var threshold = slideStep() / 5;
      if (moved < -threshold) goTo(index + 1);
      else if (moved > threshold) goTo(index - 1);
      else goTo(index);
    }

    track.addEventListener('pointerup', endDrag);
    track.addEventListener('pointercancel', endDrag);

    // impede que o clique final do arrasto vire clique em link/imagem
    track.addEventListener('click', function (e) {
      if (Math.abs(moved) > 5) { e.preventDefault(); e.stopPropagation(); }
    }, true);

    // recalcula páginas e posição quando o layout muda de largura
    var lastW = root.clientWidth;
    window.addEventListener('resize', function () {
      if (root.clientWidth === lastW) return;
      lastW = root.clientWidth;
      buildDots();
      goTo(Math.min(index, maxIndex()), false);
    });

    buildDots();
    goTo(0, false);
  })();
</script>
