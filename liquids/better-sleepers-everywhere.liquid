    margin: 60px auto !important;
    padding: 0 65px !important;
    font-family: 'Inter', sans-serif !important;
    color: var(--bsev-green) !important;
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- CABEÇALHO ---------- */

  .bsev-header {
    text-align: center !important;
    margin: 0 0 60px !important;
  }

  .bsev-stars-top {
    display: flex !important;
    justify-content: center !important;
    align-items: center !important;
    margin: 0 0 4px !important;
  }

  .bsev-stars-top svg {
    width: 24px !important;
    height: 24px !important;
    display: block !important;
    fill: var(--bsev-star) !important;
    color: var(--bsev-star) !important;
  }

  .bsev-subheading {
    font-family: 'Inter', sans-serif !important;
    font-size: 16px !important;
    font-weight: 500 !important;
    line-height: 24px !important;
    color: var(--bsev-green) !important;
    text-align: center !important;
    margin: 0 0 20px !important;
    padding: 0 !important;
  }

  .bsev-heading {
    font-family: 'Lato', sans-serif !important;
    font-size: 37px !important;
    font-weight: 700 !important;
    line-height: normal !important;
    color: var(--bsev-green) !important;
    text-align: center !important;
    margin: 0 !important;
    padding: 0 !important;
    text-transform: none !important;
    letter-spacing: normal !important;
  }

  /* ---------- TRILHO / SLIDER ---------- */

  .bsev-viewport {
    overflow: hidden !important;
    width: 100% !important;
  }

  .bsev-track {
    display: flex !important;
    align-items: stretch !important;
    gap: var(--bsev-gap) !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    transition: transform 0.45s cubic-bezier(0.25, 0.8, 0.35, 1) !important;
    will-change: transform;
    cursor: grab;
  }

  .bsev-track.bsev-dragging {
    transition: none !important;
    cursor: grabbing;
  }

  .bsev-slide {
    flex: 0 0 var(--bsev-slide-w) !important;
    width: var(--bsev-slide-w) !important;
    max-width: 100% !important;
    display: flex !important;
    margin: 0 !important;
    padding: 0 !important;
    list-style: none !important;
    user-select: none !important;
  }

  /* ---------- CARD ---------- */

  .bsev-card {
    display: flex !important;
    flex-direction: column !important;
    width: 100% !important;
    height: 100% !important;
    border: 2px solid var(--bsev-green) !important;
    border-radius: 12px !important;
    padding: 10px !important;
    background: var(--bsev-card-bg) !important;
  }

  .bsev-media {
    display: block !important;
    width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    border-radius: 12px !important;
    overflow: hidden !important;
    background: #eceff1 !important;
  }

  .bsev-media img {
    display: block !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    border-radius: 0 !important;
    margin: 0 !important;
    -webkit-user-drag: none;
  }

  .bsev-body {
    padding: 20px 0 8px !important;
  }

  /* estrelas + nota do card */
  .bsev-rating {
    display: flex !important;
    align-items: center !important;
    margin: 0 0 4px !important;
  }

  .bsev-rating svg {
    width: 15px !important;
    height: 15px !important;
    display: block !important;
    fill: var(--bsev-star) !important;
    color: var(--bsev-star) !important;
  }

  .bsev-rating-label {
    font-family: 'Inter', sans-serif !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    line-height: 20px !important;
