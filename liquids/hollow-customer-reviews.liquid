<script>
  (() => {
    const root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains("hcr-reviews")) return;

    const list = root.querySelector("[data-hcr-list]");
    const cards = Array.from(list.querySelectorAll(".hcr-review"));
    const search = root.querySelector("[data-hcr-search]");
    const rating = root.querySelector("[data-hcr-rating]");
    const sort = root.querySelector("[data-hcr-sort]");
    const photos = root.querySelector("[data-hcr-photos]");
    const empty = root.querySelector("[data-hcr-empty]");

    const applyFilters = () => {
      const term = search.value.trim().toLowerCase();
      const selectedRating = rating.value;
      const onlyPhotos = photos.checked;

      cards.forEach((card) => {
        const matchesText = !term || card.textContent.toLowerCase().includes(term);
        const matchesRating = selectedRating === "all" || card.dataset.rating === selectedRating;
        const matchesPhotos = !onlyPhotos || card.dataset.photos === "true";
        card.hidden = !(matchesText && matchesRating && matchesPhotos);
      });

      const direction = sort.value;
      const ordered = [...cards].sort((a, b) => {
        if (direction === "highest") return Number(b.dataset.rating) - Number(a.dataset.rating);
        if (direction === "lowest") return Number(a.dataset.rating) - Number(b.dataset.rating);
        if (direction === "oldest") return Number(b.dataset.order) - Number(a.dataset.order);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      ordered.forEach((card) => list.appendChild(card));
      empty.style.setProperty("display", cards.some((card) => !card.hidden) ? "none" : "block", "important");
    };

    [search, rating, sort, photos].forEach((control) => {
      control.addEventListener(control === search ? "input" : "change", applyFilters);
    });

    root.querySelector("[data-hcr-gallery-next]").addEventListener("click", () => {
      root.querySelector("[data-hcr-gallery]").scrollBy({ left: 414, behavior: "smooth" });
    });

    const galleryItems = [
      { name: "meredith c", avatar: "MC", date: "2 days ago", title: "Glad I ordered! Great for deadlifting!", body: "Easy to pull up but still wonderfully compressive. Plus natural fibers don’t stink like my old socks.", product: "Review for Compression Socks - Black / WIDE / Medium" },
      { name: "Richard L", avatar: "RL", date: "41 minutes ago", title: "So far I have much more energy in my legs!", body: "So far it seems I have much more energy in my legs!!", product: "Review for Compression Socks - Grey / WIDE / Large" },
      { name: "Merlin D", avatar: "MD", date: "1 hour ago", title: "Good compression but hard...", body: "Good compression but hard to get on and off.", product: "Review for Compression Socks - Grey / WIDE / X-Large" },
      { name: "Doug D", avatar: "DD", date: "1 hour ago", title: "Great fit and compression", body: "Comfortable compression that stays in place throughout the day.", product: "Review for Compression Socks - Black / STANDARD / X-Large" },
      { name: "Susan P", avatar: "SP", date: "3 days ago", title: "Comfortable all day", body: "Soft, supportive, and much easier to wear than my old compression socks.", product: "Review for Compression Socks - Grey / STANDARD / Medium" },
      { name: "James R", avatar: "JR", date: "4 days ago", title: "Excellent support", body: "The compression feels balanced and keeps my legs comfortable for hours.", product: "Review for Compression Socks - Grey / WIDE / Large" },
      { name: "Laura B", avatar: "LB", date: "5 days ago", title: "Exactly what I needed", body: "They feel soft against my skin and provide excellent support.", product: "Review for Compression Socks - White / STANDARD / Medium" },
      { name: "Karen T", avatar: "KT", date: "1 week ago", title: "Very happy with these socks", body: "Great quality, comfortable fit, and no uncomfortable marks around the cuff.", product: "Review for Compression Socks - Natural / WIDE / Large" }
    ];
    const thumbs = Array.from(root.querySelectorAll(".hcr-reviews__thumb"));
    const lightbox = root.querySelector("[data-hcr-lightbox]");
    const lightboxImage = root.querySelector("[data-hcr-lightbox-image]");
    const lightboxMini = root.querySelector("[data-hcr-lightbox-mini]");
    const lightboxName = root.querySelector("[data-hcr-lightbox-name]");
    const lightboxAvatar = root.querySelector("[data-hcr-lightbox-avatar]");
    const lightboxDate = root.querySelector("[data-hcr-lightbox-date]");
    const lightboxTitle = root.querySelector("[data-hcr-lightbox-title]");
    const lightboxBody = root.querySelector("[data-hcr-lightbox-body]");
    const lightboxProduct = root.querySelector("[data-hcr-lightbox-product]");
    const lightboxCounter = root.querySelector("[data-hcr-lightbox-counter]");
    let activeGalleryIndex = 0;
    let previousBodyOverflow = "";

    const renderLightbox = (index) => {
      activeGalleryIndex = (index + thumbs.length) % thumbs.length;
      const thumbImage = thumbs[activeGalleryIndex].querySelector("img");
      const item = galleryItems[activeGalleryIndex];
      lightboxImage.src = thumbs[activeGalleryIndex].dataset.hcrFull || thumbImage.currentSrc || thumbImage.src;
      lightboxMini.src = thumbImage.currentSrc || thumbImage.src;
      lightboxName.textContent = item.name;
      lightboxAvatar.textContent = item.avatar;
      lightboxDate.textContent = item.date;
      lightboxTitle.textContent = item.title;
      lightboxBody.textContent = item.body;
      lightboxProduct.textContent = item.product;
      lightboxCounter.textContent = `${activeGalleryIndex + 1} / ${thumbs.length}`;
    };

    const openLightbox = (index) => {
      renderLightbox(index);
      previousBodyOverflow = document.body.style.overflow;
      document.body.style.overflow = "hidden";
      lightbox.setAttribute("aria-hidden", "false");
      root.querySelector("[data-hcr-lightbox-close]").focus();
    };

    const closeLightbox = () => {
      lightbox.setAttribute("aria-hidden", "true");
      document.body.style.overflow = previousBodyOverflow;
      thumbs[activeGalleryIndex].focus();
    };

    thumbs.forEach((thumb, index) => {
      thumb.setAttribute("aria-label", `Open customer review photo ${index + 1}`);
      thumb.addEventListener("click", () => openLightbox(index));
    });

    root.querySelector("[data-hcr-lightbox-prev]").addEventListener("click", () => renderLightbox(activeGalleryIndex - 1));
    root.querySelector("[data-hcr-lightbox-next]").addEventListener("click", () => renderLightbox(activeGalleryIndex + 1));
    root.querySelector("[data-hcr-lightbox-close]").addEventListener("click", closeLightbox);
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    root.querySelectorAll(".hcr-review__vote").forEach((button) => {
      button.addEventListener("click", () => {
        button.style.color = "#041e3a";
        button.setAttribute("aria-pressed", "true");
      });
    });

    const modal = root.querySelector("[data-hcr-modal]");
    root.querySelector("[data-hcr-open-review]").addEventListener("click", () => modal.setAttribute("aria-hidden", "false"));
    root.querySelector("[data-hcr-close]").addEventListener("click", () => modal.setAttribute("aria-hidden", "true"));
    modal.addEventListener("click", (event) => {
      if (event.target === modal) modal.setAttribute("aria-hidden", "true");
    });

    document.addEventListener("keydown", (event) => {
      if (lightbox.getAttribute("aria-hidden") === "false") {
        if (event.key === "Escape") closeLightbox();
        if (event.key === "ArrowLeft") renderLightbox(activeGalleryIndex - 1);
        if (event.key === "ArrowRight") renderLightbox(activeGalleryIndex + 1);
      }
    });
  })();
</script>
