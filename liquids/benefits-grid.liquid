      width="32"
      height="32">
    <div class="marini-beneficios__text">Cloud-Light Feel</div>
  </div>

  <div class="marini-beneficios__card">
    <img
      class="marini-beneficios__icon"
      src="https://cdn.shopify.com/s/files/1/0590/3872/8265/files/sneaker-move-thin.svg?v=1761518120"
      alt="Stable Platform"
      loading="lazy"
      width="32"
      height="32">
    <div class="marini-beneficios__text">Stable Platform</div>
